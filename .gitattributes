# Line endings are load-bearing here, so pin them instead of letting each clone's
# core.autocrlf decide.
#
# tools/transcode.py guarantees that the CP1250 tree handed to the compiler is a
# byte-for-byte match of original/.  That proof compares real files on disk, so
# every checkout has to produce the same bytes on every platform.  These two trees
# are CRLF (a 2005 Windows project), and the working copies this repo was verified
# against are CRLF, so CRLF is what git must check out -- also on Linux, where the
# Emscripten build will eventually run.
#
# Note: these files were first committed under core.autocrlf=true and are stored
# LF-normalized in the index.  eol=crlf keeps that storage and fixes the checkout,
# which is why it shows no diff.  See PLAN.md, "Line endings in the archive".

original/**       text eol=crlf
src/engine/**     text eol=crlf

# Binary payloads: never touched, never diffed as text.
#
# These override the `original/** text eol=crlf` rule above -- later rules win -- and
# they must list every binary extension actually present in the archive.  Anything
# binary that is missing here gets the CRLF smudge applied to it on checkout, and for
# a file with no line endings to speak of that is silent corruption.  Five files were
# being mangled this way before the second block below was added.
*.iqp   binary
*.IQP   binary
*.bmp   binary
*.BMP   binary
*.ico   binary
*.ICO   binary
*.ttf   binary
*.TTF   binary
*.wav   binary
*.WAV   binary
*.exe   binary
*.EXE   binary
*.hlp   binary
*.HLP   binary

# Added after the audit: binary, present in original/, and previously being mangled.
# .fon is the bitmap font resource; .obj are 1990s MSVC objects; .gid is the help
# index; .db is an Explorer thumbnail cache the author shipped by accident.
*.fon   binary
*.FON   binary
*.obj   binary
*.OBJ   binary
*.gid   binary
*.GID   binary
*.db    binary
*.DB    binary

# The phase 1.6 golden conversation.  CP1250 with CRLF, written by the driver's
# --transcript and diffed byte for byte against the wasm run at 3.3, so git must
# not touch it: -text disables both the checkout smudge and the index
# normalization.  Not `binary` -- a changed answer should still show up in a diff,
# mojibake or not.
test/golden/rozhovor.in    -text
test/golden/rozhovor.txt   -text
