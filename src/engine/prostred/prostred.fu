void ZAPIS_DO_MENU_AKTUALNI_STAV_NASTAVENI(void) {
HMENU menu;
char *conapsat=ALOKUJ_RETEZEC(1000);

  conapsat[0]=0;
  if (g_nastaveni.jmenocloveka[0] == 0) {
    if (g_nastaveni.pohlavicloveka == 1) strcat(conapsat,"muž");
    else strcat(conapsat,"žena");
   }
  else strcat(conapsat,g_nastaveni.jmenocloveka);

  strcat(conapsat," x ");

  if (g_nastaveni.jmenopocitace[0] == 0) {
    if (g_nastaveni.pohlavipocitace == 1) strcat(conapsat,"muž");
    else strcat(conapsat,"žena");
   }
  else strcat(conapsat,g_nastaveni.jmenopocitace);

  strcat(conapsat,", ");

  switch(g_nastaveni.charakter) {
    case 0: strcat(conapsat,"stroj"); break;
    case 1: strcat(conapsat,"naivní"); break;
    case 2: strcat(conapsat,"klidný"); break;
    case 3: strcat(conapsat,"průměrný"); break;
    case 4: strcat(conapsat,"nedůvěřivý"); break;
    case 5: strcat(conapsat,"náladový"); break;
    case 6: strcat(conapsat,"výbušný"); break;
    default: NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
   }
  strcat(conapsat,": ");

  switch(g_nastaveni.nalada) {
    case 1: strcat(conapsat,"výborná"); break;
    case 2: strcat(conapsat,"dobrá"); break;
    case 3: strcat(conapsat,"normální"); break;
    case 4: strcat(conapsat,"špatná"); break;
    case 5: strcat(conapsat,"hrozná"); break;
    default: NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
   }

  menu = GetMenu(g_HWNDhlavnihookna);
  ModifyMenu(menu,2,MF_BYPOSITION | MF_STRING | MFT_RIGHTJUSTIFY,ID_NASTAVENI,conapsat);
  SetMenu(g_HWNDhlavnihookna,menu);
  DrawMenuBar(g_HWNDhlavnihookna);       //asi nemusi byt

  UVOLNI(conapsat);
 }

void NAPIS_UVODNI_UVITANI(void) {
CString kratkepohlavicloveka,priselpohlavi,kratkepohlavipocitace;

  if (g_nastaveni.pohlavicloveka == 1) { kratkepohlavicloveka=""; priselpohlavi="přišel"; }
  else { kratkepohlavicloveka="a"; priselpohlavi="přišla"; }
  if (g_nastaveni.pohlavipocitace == 1) { kratkepohlavipocitace=""; }
  else { kratkepohlavipocitace="a"; }

  srand(time(NULL));

  switch(rand()%10) {
    case 0: NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU("","Ahoj! Dobře, že mě spouštíš :-)"); break;
    case 1: NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU("","Vítám tě! Jak ses měl"+kratkepohlavicloveka+"?"); break;
    case 2: NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU("","Nazdar! Jsem rád"+kratkepohlavipocitace+", že ses na mě "+priselpohlavi+" podívat."); break;
    case 3: NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU("","Čest pěst! Co tě ke mně přivádí?"); break;
    case 4: NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU("","Nazdárek, jdeš si zakydat?"); break;
    case 5: NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU("","No, to je dobře, že se taky na mě přijdeš jednou podívat."); break;
    case 6: NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU("","Zdar! Jak žiješ?"); break;
    case 7: NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU("","Vítej, kámo!"); break;
    case 8: NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU("","Jsem moc rád"+kratkepohlavipocitace+", že si se mnou jdeš pokydat."); break;
    case 9: NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU("","Ahoj, tak co je nového?"); break;
   }
 }

void ZMEN_FONT_U_TEXTU_NA_OBRAZOVCE(CWnd *handletextu,BYTE velikost,char *jakepismo) {
CFont cFont;
LOGFONT font;

  ZeroMemory(&font, sizeof(LOGFONT));
  font.lfHeight = -velikost;
  font.lfWeight = FW_BOLD;
  strcpy(font.lfFaceName,jakepismo);

  cFont.CreateFontIndirect(&font);
  handletextu->SetFont(&cFont);
  cFont.~CFont();  //nemusi byt
 }

void NASTAV_VIDITELNOST_POZADI(BYTE refresh) {
  if (g_nastaveni.prikaz_nezobrazovatpozadi == 1) {
    g_stetecpozadihlavnihookna=CreateSolidBrush(0x000000);
                                 //hlavni okno bude mit cerne pozadi
    g_stetecpozadipodokna=CreateSolidBrush(GetSysColor(COLOR_3DFACE));
                                 //podokno bude mit standardni barvu
    g_stetecpozadizadavanivety=CreateSolidBrush(0xFFFFFF);
   }
  else {
    g_obrazekpozadihlavnihookna = (HBITMAP)LoadImage(g_instanceprogramu, MAKEINTRESOURCE(IDB_POZADIHLAVNIHOOKNA), IMAGE_BITMAP, 0, 0, LR_DEFAULTSIZE);
    g_stetecpozadihlavnihookna=CreatePatternBrush(g_obrazekpozadihlavnihookna);
    g_stetecpozadipodokna=CreatePatternBrush(LoadBitmap(GetModuleHandle(NULL),MAKEINTRESOURCE(IDB_POZADIMALE)));
    g_stetecpozadizadavanivety=CreateSolidBrush(g_barvapozadizadavanivety);
   }

  if (refresh == 1) PREKRESLI_OBRAZOVKU();
 }

DWORD WINAPI VLAKNO__BLIKNUTI_S_NAPISEM_IQPOKYD(LPVOID lpParameter) {
                           //zablikani napisem "IQ Pokyd"
BYTE velikost=18;
CFont *puvodnifont;

  puvodnifont=g_CWndhlavnihookna->GetDlgItem(IDC_NADPIS2)->GetFont();

  while (velikost > 10 && g_zavritvlaknoefektu == 0) {  //zmenseni fontu
    ZMEN_FONT_U_TEXTU_NA_OBRAZOVCE(g_CWndhlavnihookna->GetDlgItem(IDC_NADPIS2),velikost,"Garamond");
    velikost--;
    Sleep(20);
   }
  while (velikost <= 21 && g_zavritvlaknoefektu == 0) {  //zvetseni fontu
    ZMEN_FONT_U_TEXTU_NA_OBRAZOVCE(g_CWndhlavnihookna->GetDlgItem(IDC_NADPIS2),velikost,"Garamond");
    velikost++;
    Sleep(2*velikost+4*(velikost-10));
   }
//
  g_CWndhlavnihookna->GetDlgItem(IDC_NADPIS2)->SetFont(puvodnifont);

  return 0;
 }
  
DWORD WINAPI VLAKNO__EFEKTY(LPVOID lpParameter) {
WORD pozice;
BYTE predchoziakce=0,predchozipouzivani=g_nastaveni.pouzivatefekty;

  SendDlgItemMessage(g_HWNDhlavnihookna,IDC_EFEKTPROGRES1,PBM_SETRANGE32,0,1000);
  SendDlgItemMessage(g_HWNDhlavnihookna,IDC_EFEKTPROGRES2,PBM_SETRANGE32,0,1000);

  while (g_zavritvlaknoefektu == 0) {

    if (g_akceefektu != predchoziakce) {    //zmena akce, vynulovani
      predchoziakce=g_akceefektu; pozice=0;
      SendDlgItemMessage(g_HWNDhlavnihookna,IDC_EFEKTPROGRES1,PBM_SETPOS,0,0);
      SendDlgItemMessage(g_HWNDhlavnihookna,IDC_EFEKTPROGRES2,PBM_SETPOS,0,0);
     }
    if (g_nastaveni.pouzivatefekty != predchozipouzivani) {
      predchozipouzivani=g_nastaveni.pouzivatefekty;
      if (g_nastaveni.pouzivatefekty == 0) {     //vypnuti efektu
        SendDlgItemMessage(g_HWNDhlavnihookna,IDC_EFEKTPROGRES1,PBM_SETPOS,0,0);
        SendDlgItemMessage(g_HWNDhlavnihookna,IDC_EFEKTPROGRES2,PBM_SETPOS,0,0);
       }
     }

    if (g_nastaveni.pouzivatefekty == 0) {   //nepouzivat efekty
      Sleep(100); continue;
     }

    switch(predchoziakce /* je stejna jako g_akceefektu */) {
      case 0: break;                        //nic

      case 1:                   //vertikalni "vystup" nahoru
        SendDlgItemMessage(g_HWNDhlavnihookna,IDC_EFEKTPROGRES1,PBM_SETPOS,(DWORD)pozice,0);
        SendDlgItemMessage(g_HWNDhlavnihookna,IDC_EFEKTPROGRES2,PBM_SETPOS,(DWORD)pozice,0);
        pozice+=100;
        if (pozice > 1000) {      //uz vyjel az nahoru
          pozice=0; g_akceefektu=0;
         }
        break;

      case 2:                              //2x zablikani
        if (pozice == 0 || pozice == 20) {    //vypnuto, tak se "rozsvit"
          SendDlgItemMessage(g_HWNDhlavnihookna,IDC_EFEKTPROGRES1,PBM_SETPOS,1000,0);
          SendDlgItemMessage(g_HWNDhlavnihookna,IDC_EFEKTPROGRES2,PBM_SETPOS,1000,0);
          pozice++;
         }
        else if (pozice == 10 || pozice == 30) { //zapnuto, tak "zhasni"
          SendDlgItemMessage(g_HWNDhlavnihookna,IDC_EFEKTPROGRES1,PBM_SETPOS,0,0);
          SendDlgItemMessage(g_HWNDhlavnihookna,IDC_EFEKTPROGRES2,PBM_SETPOS,0,0);
          pozice++;
         }
        else if (pozice > 30) {    //skonci, uz jsi 2x zablikal
          pozice=0; g_akceefektu=0;
         }
        else pozice++;
        break;
      default: NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
     }
    Sleep(20);
   }
  g_zavritvlaknoefektu=0;
  g_bezivlaknoefektu=0;

  return 0;
 }

DWORD WINAPI VLAKNO__HLASKY_A_OPERACE_NA_POZADI(LPVOID lpParameter) {
  while (g_zavritvlaknohlasek == 0) {
    Sleep(100);
    if (g_zobrazithlasku[0] == _PREKRESLIT_OBRAZOVKU_) {
//!      PREFORMATUJ_TEXTY_CLOVEKA_A_POCITACE_NA_OBRAZOVCE(1);
      PREKRESLI_OBRAZOVKU();
      ZOBRAZ_HLASKU_NA_POZADI(0,0);     //vymazani z fronty
     }
    if (g_zobrazithlasku[0] == _UVODNI_KEC_) {
      ZOBRAZ_HLASKU_NA_POZADI(0,0);     //vymazani z fronty
/*//!      g_zobrazenahlaska=1;

      MessageBox(g_rodichlasky,""
      "Ahoj!"
      "\n\nVítej v programu IQ Pokyd. Dobře, že mě spouštíš. "
      "Budu ti tykat, tak si na to zvykni :-)"
      "\n\nToto je první verze programu IQ Pokyd, která samozřejmě má ještě "
      "hodně nedostatků (to také napovídá číselné označení verze 0.15). "
      "Proto prosím omluv sníženou kvalitu a IQ programu."
      "\n\nDík a hodně zábavy!"
      "\n\nP.S.: Pokud se se mnou budeš hodně nudit, stáhni si předchůdce "
      "tohoto programu Pokyd z \"http://iqpokyd.kyblsoft.cz\" - přece jenom je ještě "
      "v mnohém dokonalejší."
                       "","Vítej v programu IQ Pokyd v0.15",MB_ICONINFORMATION | MB_SYSTEMMODAL);
      SetFocus(g_HWNDhlavnihookna); g_zobrazenahlaska=0;
*/     }
    if (g_zobrazithlasku[0] == _O_VYTVARENI_SLOVNIKU_) {
      ZOBRAZ_HLASKU_NA_POZADI(0,0);     //vymazani z fronty
      g_zobrazenahlaska=1;

      MessageBox(g_rodichlasky,""
      "Nyní je třeba vytvořit tzv. \"velký slovník\". To může trvat "
      "i několik minut. Tato operace se provede pouze při tomto prvním spuštění, "
      "příště se už program spustí rychle. \r\n\r\n"
      "Výsledek tohoto procesu se uloží "
      "do souboru SLOVNIK.TMP. Ten zabere asi 17 MB a je to zdaleka největší "
      "soubor IQ Pokydu. "
      "Pokud tedy budeš v budoucnu program šířit, můžeš tento soubor "
      "s klidným svědomím smazat, na novém počítači se vytvoří znova."
                       "","Co se právě dělá",MB_ICONINFORMATION | MB_SYSTEMMODAL);
      if (::IsWindow(g_HWNDpodokna) == TRUE) SetFocus(g_HWNDpodokna);
      g_zobrazenahlaska=0;
     }
    if (g_zobrazithlasku[0] == _NEKDO_SI_HRAL_S_NASTAVENIM_) {
      ZOBRAZ_HLASKU_NA_POZADI(0,0);     //vymazani z fronty
      g_zobrazenahlaska=1;

      MessageBox(g_rodichlasky,""
      "Soubor s nastavením "JMENO_SOUBORU_S_NASTAVENIM" je nějaký špatný. "
      "Někdo se v něm asi vrtal, nevíš o něm něco? "
      "Já se nezlobím, ale holt si mě budeš muset nastavit znovu, no. "
                       "","Špatný soubor s nastavením",MB_ICONINFORMATION | MB_SYSTEMMODAL);
      if (::IsWindow(g_HWNDpodokna) == TRUE) SetFocus(g_HWNDpodokna);
      g_zobrazenahlaska=0;
     }

    if (g_zobrazithlasku[0] == 0 && g_zobrazitnastaveni == 1) {
      g_zobrazitnastaveni=0;
      SendMessage(g_HWNDhlavnihookna,WM_COMMAND,(UINT)ID_NASTAVENI,0);
     }
   }
  g_zavritvlaknohlasek=0;
  g_bezivlaknohlasek=0;
  CloseHandle(g_handlevlaknahlasek);
  return 0;
 }

DWORD WINAPI VLAKNO__PROCENTA_PROGRESU(LPVOID lpParameter) {
char *procentatext=ALOKUJ_RETEZEC(20);
long double procenta;

  do {
    procenta=g_procentanacitani;
    switch(g_praveprovadenaakce) {
      case 1: break;          //nacitani cehokoliv
      case 2:                 //vytvareni slovniku (0-50%)
              procenta=procenta*50/100; break;
      case 3:                 //trideni slovniku (50-100%)
              procenta=procenta*50/100+50; break;
      case 4: break;          //zapisovani velkeho slovniku - novy progres
      case 5: break;          //ostatni (podradne) akce
     }

    switch(g_praveprovadenaakce) {
      case 1: case 4: case 5: sprintf(procentatext,"%.0f%%",procenta); break;
      default: sprintf(procentatext,"%.1f%%",procenta); break;
     }
    if (PREDPREDPOSLEDNI_ZNAK(procentatext) == '.')
     procentatext[strlen(procentatext)-3]=',';  //desetinna carka
    g_handletext2->SetWindowText(procentatext);
    SendDlgItemMessage(g_HWNDpodokna,IDC_PROGRESNACITANI,PBM_SETPOS,(DWORD)(procenta*10),0);

    switch (g_praveprovadenaakce) {
      case 1: case 4: case 5: Sleep(50); break;
      default: Sleep(100); break;
     }
   } while (g_bezivlaknoprocesu == 1 && g_zavritvlaknoprocent == 0);

  UVOLNI(procentatext);

  g_zavritvlaknoprocent=0;
  g_bezivlaknoprocent=0;

  if (g_bezivlaknoprocesu == 0) SendMessage(g_HWNDpodokna,WM_CLOSE,0,0);
  CloseHandle(g_handlevlaknaprocent);
  return 0;
 }

DWORD WINAPI VLAKNO__NACITEJ_JAK_DIVEJ(LPVOID lpParameter) {
HWND hlaska;
DWORD pozice;

  g_praveprovadenaakce=5;
  g_procentanacitani=0;

  if (g_zavritvlaknoprocesu == 1) {
    g_nastaveni.debug_rychleukoncovani=1; goto SKONCI;  //je alokována pouze část paměti
   }

  ALOKUJ_VSECHNY_PRVKY_G_VETACLOVEKA();
  if (g_zavritvlaknoprocesu == 1) {
    g_nastaveni.debug_rychleukoncovani=1; goto SKONCI;  //je alokována pouze část paměti
   }

  g_praveprovadenaakce=5;
  g_procentanacitani=0;
  g_handletext1->SetWindowText("Načítám základní slovník...");
  PRECTI_DATABAZI_SLOV_ZE_ZAKLADNIHO_SLOVNIKU();
  if (g_zavritvlaknoprocesu == 1) {
    g_nastaveni.debug_rychleukoncovani=1; goto SKONCI;  //je alokována pouze část paměti
   }

  g_praveprovadenaakce=1;
  g_procentanacitani=0;
  g_handletext1->SetWindowText("Načítám slovní zásobu...");
  if (PRECTI_DATABAZI_SLOV_Z_UPLNEHO_SLOVNIKU() == 1) {
    if (g_zavritvlaknoprocesu == 1) goto SKONCI;
    SetWindowText(g_HWNDpodokna,"Vytvářím slovní zásobu, prosím čekejte...");
    NACTI_A_ROZSKLONUJ_ZAKLADNI_SLOVNIK();
    if (g_zavritvlaknoprocesu == 1) goto SKONCI;
   }
  
  g_praveprovadenaakce=5;
  g_procentanacitani=0;
  g_handletext1->SetWindowText("Načítám inteligenci...");
  PRECTI_INTELIGENCI_ZE_SOUBORU();
  g_odpovedipocitace=(char **)ALOKUJ_PAMET(g_pocetiqpodminek*sizeof(*g_odpovedipocitace));
  g_idodpovedipocitace=(WORD *)ALOKUJ_PAMET(g_pocetiqpodminek*sizeof(g_idodpovedipocitace[0]));
  for (pozice=0; pozice < g_pocetiqpodminek; pozice++) {
    g_odpovedipocitace[pozice]=ALOKUJ_RETEZEC(MAX_DELKA_ODPOVEDI_POCITACE+1);
   }
  if (g_zavritvlaknoprocesu == 1) {
    g_nastaveni.debug_rychleukoncovani=1; goto SKONCI;  //je alokována pouze část paměti
   }

  g_praveprovadenaakce=5;
  g_procentanacitani=0;
  g_handletext1->SetWindowText("Načítám externí data...");
  PRECTI_PROFIL_ZE_SOUBORU();
  if (g_zavritvlaknoprocesu == 1) goto SKONCI;

  g_procentanacitani=30;
  g_tuknuti.DOVYTVOR_VSECHNY_ZVUKY_TUKNUTI();
  if (g_zavritvlaknoprocesu == 1) goto SKONCI;

  g_procentanacitani=70;
  switch(ZKONTROLUJ_SPRAVNY_OBSAH_SOUBORU_S_NAPOVEDOU()) {
    case 0:  //soubor s nápovědou neexistuje
      NAHLAS_CHYBU("Bohužel, program IQ Pokyd je narušen; konkrétně chybí soubor s nápovědou \"" JMENO_SOUBORU_S_NAPOVEDOU "\". Možná si řekneš, že je to kravina, ale už z principu se musím ukončit, není možné, aby mě takhle někdo \"ořezával\".\r\n\r\nCo s tím: Nahraj si tento soubor ze zdroje znova. Nemáš-li už odkud, tak z internetu ze stránky \"http://iqpokyd.kyblsoft.cz\".\r\n\r\nDíky!",0,_JINA_CHYBA_,_UKONCIT_);
    case 1: break;   //v pořádku
    case 2:  //soubor s nápovědou je narušen
      NAHLAS_CHYBU("Bohužel, program IQ Pokyd je narušen; konkrétně je špatný soubor s nápovědou \"" JMENO_SOUBORU_S_NAPOVEDOU "\". Je možné, že je soubor špatně nahraný nebo ho nějaký chytrák prostě přepsal k obrazu svému. To se mi však pochopitelně nelíbí a proto se nyní ukončím.\r\n\r\nCo s tím: Nahraj si tento soubor ze zdroje znova. Nemáš-li už odkud, tak z internetu ze stránky \"http://iqpokyd.kyblsoft.cz\".\r\n\r\nDíky!",0,_JINA_CHYBA_,_UKONCIT_);
    default: NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
   }
  if (g_zavritvlaknoprocesu == 1) goto SKONCI;

  DWORD vlakno;
  CreateThread(NULL,0,VLAKNO__BLIKNUTI_S_NAPISEM_IQPOKYD,(LPVOID)0,0,&vlakno);

  SKONCI:
  g_zavritvlaknoprocesu=0;
  g_bezivlaknoprocesu=0;
  hlaska=FindWindow(NULL,"IQ Pokyd - Upozornění");
  if (hlaska != NULL)
   EndDialog(hlaska,IDNO);
  if (g_bezivlaknoprocent == 0) SendMessage(g_HWNDpodokna,WM_CLOSE,0,0);
  CloseHandle(g_handlevlaknaprocesu);
  return 0;
 }

void WINMFC_NACTI_SLOVNIKY(void) {
DWORD dwVlakno1,dwVlakno2;
 
  SendDlgItemMessage(g_HWNDpodokna,IDC_PROGRESNACITANI,PBM_SETRANGE32,0,1000);
  SendDlgItemMessage(g_HWNDpodokna,IDC_PROGRESNACITANI,PBM_SETPOS,0,0);

  g_bezivlaknoprocesu=1;
  g_handlevlaknaprocesu=CreateThread(NULL,0,VLAKNO__NACITEJ_JAK_DIVEJ,(LPVOID)0,0,&dwVlakno1);
  if (!g_handlevlaknaprocesu) NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);

  g_bezivlaknoprocent=1;
  g_handlevlaknaprocent=CreateThread(NULL,0,VLAKNO__PROCENTA_PROGRESU,(LPVOID)0,0,&dwVlakno2);
  if (!g_handlevlaknaprocent) NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
 }

void WINMFC_UVOLNI_VESKEROU_DYNAMICKOU_PAMET(void) {
  UVOLNI_VESKEROU_DYNAMICKOU_PAMET();
 }

CString VRAT_NAZEV_MESICE(WORD mesic) {
  switch(mesic) {
    case 1: return("ledna");
    case 2: return("února");
    case 3: return("března");
    case 4: return("dubna");
    case 5: return("května");
    case 6: return("června");
    case 7: return("července");
    case 8: return("srpna");
    case 9: return("září");
    case 10: return("října");
    case 11: return("listopadu");
    case 12: return("prosince");
    default: NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
             return("");  //pouze pro prekladac
   }
 }

void ULOZ_KYDY(void) {
FILE *fw=NULL;
SYSTEMTIME sysTime;

  if (g_nastaveni.prikaz_readonlymod == 1) return;    //bez zapisu

  fw=OTEVRI_SOUBOR(JMENO_SOUBORU_S_TEXTOVYMI_ZAZNAMY,"ab");
  if (fw == NULL) return;

  GetLocalTime(&sysTime);
  fprintf(fw,""
"-------------------------------------------------------------------\r\n"
" Záznam rozhovoru z programu IQ Pokyd v0.15 - %d.%s %d v %d:%02d\r\n"
"      Aleš Janda (C) KÝBLSoft 1999-2005, http://iqpokyd.kyblsoft.cz\r\n"
"-------------------------------------------------------------------\r\n\r\n"
"%s\r\n\r\n\r\n"
"",sysTime.wDay,VRAT_NAZEV_MESICE(sysTime.wMonth),sysTime.wYear,sysTime.wHour,sysTime.wMinute,g_zaznamrozhovoru);
  fclose(fw);
 }

void ULOZ_BINARNI_KYDY(void) {
FILE *soubor=NULL;
SYSTEMTIME sysTime;
BYTE pocetzbytecnosti,koneckodovani;
int delkahlavicky,pozice;
char nahodnykodovaciklic,*hlavicka=NULL,*data=NULL,predchoziznak,novypredchoziznak;

  if (g_nastaveni.prikaz_readonlymod == 1) return;    //bez zapisu

  soubor=OTEVRI_SOUBOR(JMENO_SOUBORU_S_BINARNIMI_ZAZNAMY,"rb");
  if (soubor != NULL) {
    fseek(soubor,0,SEEK_END); if (ftell(soubor) > 10) {   //neco uz tam je
      fclose(soubor); goto ZAPIS;
     }
    fclose(soubor);
   }
  soubor=OTEVRI_SOUBOR(JMENO_SOUBORU_S_BINARNIMI_ZAZNAMY,"wb");

  hlavicka=ALOKUJ_RETEZEC(500);

  strcpy(hlavicka,"IQ Pokyd v0.15 - nova slova, gramaticke vyznamy, struktury vet: TENTO SOUBOR NEOBSAHUJE ZADNA CITLIVA DATA. Prosim odeslete tento soubor ve formulari na strance \"http://iqpokyd.kyblsoft.cz\", prispejete tim k rozvoji IQ Pokydu. Dekujeme.");
  delkahlavicky=strlen(hlavicka)+1;   //i s nulou na konci

  pocetzbytecnosti=rand()%100;
  hlavicka[delkahlavicky++]=pocetzbytecnosti^'I';
  for (pozice=0; pozice< pocetzbytecnosti; pozice++)
   hlavicka[delkahlavicky++]=(char)rand();  //zbytecnosti (pro zmateni hackera)

  pozice=delkahlavicky;

  nahodnykodovaciklic=(char)rand();

  hlavicka[pozice++]=nahodnykodovaciklic ^'I'; //nahodny kodovaci klic
  //(je pouzit vlastne jen pro zakodovani hlavicky, jinde jsou jine)

  hlavicka[pozice++]=(5 ^'K')+nahodnykodovaciklic;  //signatura binarnich zaznamu rozhovoru

  hlavicka[pozice++]=(0 ^'K')+nahodnykodovaciklic;
   hlavicka[pozice++]=(15 ^'K')+nahodnykodovaciklic;//verze IQ Pokydu 0.15

  hlavicka[pozice++]=(0 ^'K')+nahodnykodovaciklic;//verze dat 0

  fwrite(hlavicka,pozice,1,soubor);
  fclose(soubor);

  UVOLNI(hlavicka);


  ZAPIS:
  soubor=OTEVRI_SOUBOR(JMENO_SOUBORU_S_BINARNIMI_ZAZNAMY,"ab");
  if (soubor == NULL) return;

  GetLocalTime(&sysTime);
  data=ALOKUJ_RETEZEC(strlen(g_zaznamrozhovoru)+100);
  sprintf(data,"IQ Pokyd v0.15 - %d.%d.%d v %d:%02d\r\n%s",sysTime.wDay,sysTime.wMonth,sysTime.wYear,sysTime.wHour,sysTime.wMinute,g_zaznamrozhovoru);

  nahodnykodovaciklic=(char)rand();
  putc(nahodnykodovaciklic^'I',soubor);

  predchoziznak=0; koneckodovani=0;
  for (pozice=0; koneckodovani == 0; pozice++) {
    if (data[pozice] == 0) koneckodovani=1;
                           //aby se zakodovala i nula na konci

    data[pozice]^=nahodnykodovaciklic;
    data[pozice]+=(char)pozice;
    data[pozice]^=predchoziznak;
    novypredchoziznak=data[pozice];
    data[pozice]-=(char)(pozice*nahodnykodovaciklic);
    data[pozice]^='Q';
    data[pozice]+=nahodnykodovaciklic;
    data[pozice]^=predchoziznak;
    data[pozice]+=pozice/4;
    data[pozice]^=pozice/256;

    predchoziznak=novypredchoziznak;
   }
  
  fwrite(data,pozice,1,soubor);

  fclose(soubor);

  UVOLNI(data);
 }

void ZOBRAZ_NAPOVEDU(void) {
  CText dlg;

  CString pohlavi,dlpohlavi;
  if (g_nastaveni.pohlavicloveka == 2) { pohlavi="a"; dlpohlavi="á"; }
  else { pohlavi=""; dlpohlavi="ý"; }
  dlg.nadpis="IQ Pokyd - Nápověda";

  dlg.text="<h><u>IQ Pokyd v0.15</u></h>\r\n\r\n"
"<c><u>Jak to tu funguje:</u></c>\r\n"
"Je to jednoduché. Do řádku dole píšeš věty a já ti na ně odpovídám. "
"Je to prostě povídání člověka s počítačem.\r\n\r\n"
"Samozřejmě ode mě nemůžeš očekávat žádnou zářnou inteligenci, "
"nejsem nic víc než stroj. Chybí mi zejména pojem o světě, \"nežiju\", "
"ale i tak se snažím :-)\r\n\r\n"
"A nějaká pravidla, která bys měl"+pohlavi+" dodržovat:\r\n"
"<c>1) Piš s diakritikou</c> - diakritika jsou háčky a čárky. Toto dodržovat "
"prostě musíš, protože jinak ti rozumět nebudu. Jestli jsi tedy "
"zvykl"+dlpohlavi+" z Pokydu (nebo jiného programu :-) ) psát bez "
"diakritiky, tak si rychle odvykni. Je to v tvém zájmu.\r\n"
"<c>2) Za otázkou piš otazník</c> - zní to jako samozřejmost, ale mnoho lidí "
"to přesto nedělá. Přitom já nemůžu podle ničeho jiného poznat, jde-li "
"o otázku (i stavba věty je většinou stejná). Tak překonej lenost, "
"zjisti si, kde na klávesnici je otazník a hlavně ho piš.\r\n"
"<c>3) Piš co nejjednodušší věty</c> - tj. nejlépe věty jednoduché, těm nejsnáz "
"porozumím. To ale neznamená, že budeš věty odflinkávat. S větami typu "
"\"co včera?\", \"to ne\" atd. mě moc nenadchneš.\r\n"
"<c>4) Piš spisovně</c> - nespisovnou češtinu nemám rád. Většinou jí porozumím, "
"ale alespoň se snaž. A ještě něco - prznění češtiny typu \"jaxe máš?\""
"neakceptuji a ani akceptovat nehodlám, ale to snad není tvůj případ.\r\n\r\n"
"Tento program je <u>freeware</u>. Autor z toho sice nemá ani korunu, ale zato "
"ty mě můžeš libovolně šířit a užívat. Podmínkou však je, že to bude "
"se všemi soubory, nesmíš mě modifikovat nebo šířit za poplatky. "
"Pokud máš zájem mě distribuovat např. na CD nebo DVD, je minimálně "
"slušností to oznámit autorovi, jinak můžeš zcela bez omezení.\r\n\r\n"
"Takže přeji příjemnou zábavu! :-)\r\n\r\n"
"<u>Naprogramoval Aleš Janda - KÝBLSoft 1999-2005</u>\r\n\r\n"
"Informace o IQ Pokydu a jeho aktualizace:\r\n"
"<c>http://iqpokyd.kyblsoft.cz</c>\r\n"
"E-mail na autora:\r\n"
"<c>iqpokyd@kyblsoft.cz</c>\r\n";

  dlg.DoModal();
 }

void PREKRESLI_OBRAZOVKU(void) {
HBITMAP staraBitmapa,novaBitmapa;
RECT okno;
HBRUSH staryobrazek,novyobrazek;

  if (g_nastaveni.prikaz_nezobrazovatpozadi != 1) {
    GetClientRect(g_HWNDhlavnihookna, &okno);
    novaBitmapa = (HBITMAP)LoadImage(g_instanceprogramu, MAKEINTRESOURCE(IDB_POZADIHLAVNIHOOKNA), IMAGE_BITMAP, okno.right, okno.bottom, 0);

    staryobrazek=g_stetecpozadihlavnihookna;
    staraBitmapa=g_obrazekpozadihlavnihookna;

    novyobrazek=CreatePatternBrush(novaBitmapa);
    g_stetecpozadihlavnihookna=novyobrazek;
    g_obrazekpozadihlavnihookna=novaBitmapa;

    Sleep(1); //aby se dokreslilo to, co se pripadne ted vykresluje
    DeleteObject(staryobrazek);
    DeleteObject(staraBitmapa);
   }
  RedrawWindow(g_HWNDhlavnihookna, NULL, NULL, RDW_ERASE | RDW_INVALIDATE | RDW_ERASENOW);
 }

void ZMEN_POZICI_PRVKU(HWND objekt,int x,int y) {
  SetWindowPos(objekt, NULL, x, y, 0, 0, SWP_NOSIZE | SWP_NOZORDER);
 }

void ZMEN_VELIKOST_PRVKU(HWND objekt,int sirka,int vyska) {
  SetWindowPos(objekt, NULL, 0, 0, sirka, vyska, SWP_NOMOVE | SWP_NOZORDER);
 }

char *VRAT_ZALOMENY_TEXT_PRO_VYKRESLENI_NA_OBRAZOVKU(HDC hDc,HFONT hFont,CString text,int maxdelka_x,int vyska,int &pocetradku) {
                      //vrátí zalomený text a počet řádků v něm

char *navrat=ALOKUJ_RETEZEC(text.GetLength()*2+1);
int pozice,odkud,docasnapozice;
SIZE velikost;

  maxdelka_x -= 15;  //rezerva (nevim, proc musi byt, ale jinak to obcas zalomi zbytecne!!!)

  strcpy(navrat,text);
  SelectObject(hDc,hFont);
  GetTextExtentPoint32(hDc, navrat, strlen(navrat), &velikost);
  if (velikost.cx <= maxdelka_x && velikost.cy <= vyska) {
                        //ve většině případů, zvyšuje to rychlost
    pocetradku=1; return(navrat);
   }

  odkud=0; pocetradku=1;
  for (pozice=0; true; pozice++, odkud=pozice) {
    do {
      docasnapozice=pozice;
      for (pozice++; navrat[pozice] != ' ' && navrat[pozice] != 0; pozice++);
                                     //nalezeni dalsiho slova
      SelectObject(hDc,hFont);
      GetTextExtentPoint32(hDc, navrat+odkud, pozice-odkud, &velikost);
     } while (velikost.cx <= maxdelka_x && velikost.cy <= vyska && navrat[pozice] != 0);

    if (velikost.cx > maxdelka_x || velikost.cy > vyska) {
      if (docasnapozice > odkud) pozice=docasnapozice;
      else {           //nelze zalomit po slovech
        pozice=docasnapozice;
        do {
          pozice++;           //rozdeleni po jednotlivych znacich
          SelectObject(hDc,hFont);
          GetTextExtentPoint32(hDc, navrat+odkud, pozice-odkud, &velikost);
         } while (velikost.cx <= maxdelka_x && velikost.cy <= vyska && navrat[pozice] != 0);
        pozice--;
                                           //posunuti
        for (int i=strlen(navrat); i >= pozice; i--) navrat[i+1]=navrat[i];
        navrat[pozice]='\n'; pocetradku++;
       }
     }

    if (navrat[pozice] == 0) break;             //konec vety
    if (navrat[pozice] == ' ') { pocetradku++; navrat[pozice]='\n'; }
   }

  return(navrat);
 }

#define OKRAJE 15
#define ROZESTUP 10

void PREFORMATUJ_TEXTY_CLOVEKA_A_POCITACE_NA_OBRAZOVCE(BYTE zmenavelikosti) {
int pozice,pozice_y,radkuprvku,poz,vlevo,vpravo,nahore,dole,zobrazenychvet=100;
static int vyskaznaku=0,prvnispusteni=1;
RECT rozmery,aktrozmery;
SIZE velikost;
HDC hDc;
char *novaveta=NULL;

HFONT hFont;
LOGFONT font;

  ZeroMemory(&font, sizeof(LOGFONT));
  font.lfHeight = 20;
  strcpy(font.lfFaceName,"Trebuchet MS");

  hFont=CreateFontIndirect(&font);

              //nastaveni okraju
  GetClientRect(g_HWNDhlavnihookna,&rozmery);
  vlevo=OKRAJE+10; vpravo=rozmery.right-OKRAJE-10;
  nahore=OKRAJE+20; dole=rozmery.bottom-OKRAJE-45;
  pozice_y = dole;

              //zjisteni HDC
  CPaintDC dc(g_CWndhlavnihookna);
  hDc=dc.GetSafeHdc();

  if (zmenavelikosti == 0 && prvnispusteni == 0)       //pri zmene velikosti neni zakaz prekresleni (strasne to blika)
   SendMessage(g_HWNDhlavnihookna,WM_SETREDRAW,(WPARAM)FALSE,(LPARAM)0);


  for (pozice=99; pozice >= 1; pozice--) {            //tohle by slo zoptimalizovat
    if (g_MfcDlghlavniokno.policka[pozice] != NULL) {
      ShowWindow(g_MfcDlghlavniokno.policka[pozice]->m_hWnd,SW_HIDE);
     }
   }

  //vykresleni celistvych vet
  for (pozice=99; pozice >= 1; pozice--) {
    if (g_poslednich100vet.puvodcevety[pozice] == 0) goto KONEC; //konec

    pozice_y -= ROZESTUP;

    if (g_MfcDlghlavniokno.policka[pozice] == NULL) {           //pouze u nove vytvareneho objektu (jednou za spusteni)
      g_MfcDlghlavniokno.policka[pozice] = new CStatic();
      g_MfcDlghlavniokno.policka[pozice]->Create("STATIC",WS_CHILD | WS_VISIBLE, CRect(0,0,0,0), g_CWndhlavnihookna);
      g_MfcDlghlavniokno.policka[pozice]->SendMessage(WM_SETFONT,(WPARAM)hFont,TRUE);

      if (prvnispusteni == 1) {              //urceni vysky 1 znaku - pouze jednou za program
        SelectObject(hDc,hFont);
        GetTextExtentPoint32(hDc, "a", 1, &velikost);
        vyskaznaku=velikost.cy;
       }
     }
    if (pozice < 98 && zmenavelikosti == 0) {    //posunuti starych vet
      GetClientRect(g_MfcDlghlavniokno.policka[pozice]->m_hWnd,&aktrozmery);
      pozice_y-= aktrozmery.bottom;
      if (pozice_y < nahore) {        //neuplna veta uplne nahore - vyskoci z cyklu
        pozice_y+= aktrozmery.bottom;   //vraceni zpatky
        SelectObject(hDc,hFont);
        novaveta=VRAT_ZALOMENY_TEXT_PRO_VYKRESLENI_NA_OBRAZOVKU(hDc,hFont,g_poslednich100vet.vety[pozice],vpravo-vlevo,vyskaznaku,radkuprvku);
        break;
       }
      ZMEN_POZICI_PRVKU(g_MfcDlghlavniokno.policka[pozice]->m_hWnd, vlevo, pozice_y);
     }
    else {              //vykresleni novych vet
      SelectObject(hDc,hFont);
      novaveta=VRAT_ZALOMENY_TEXT_PRO_VYKRESLENI_NA_OBRAZOVKU(hDc,hFont,g_poslednich100vet.vety[pozice],vpravo-vlevo,vyskaznaku,radkuprvku);

      g_MfcDlghlavniokno.policka[pozice]->SetWindowText(novaveta);
      pozice_y-= radkuprvku*vyskaznaku;
      if (pozice_y < nahore) {
        pozice_y+= radkuprvku*vyskaznaku;       //vraceni zpatky
        break;
       }

      ZMEN_POZICI_PRVKU(g_MfcDlghlavniokno.policka[pozice]->m_hWnd, vlevo, pozice_y);
      ZMEN_VELIKOST_PRVKU(g_MfcDlghlavniokno.policka[pozice]->m_hWnd, vpravo-vlevo, vyskaznaku*radkuprvku);

      UVOLNI(novaveta);
     }
    ShowWindow(g_MfcDlghlavniokno.policka[pozice]->m_hWnd,SW_SHOW);
   }

  //vykresleni zbytku vety, ktery se vejde
  radkuprvku=(pozice_y-nahore)/vyskaznaku;
  for (poz=strlen(novaveta)-1; radkuprvku > 0; poz--) {
    if (novaveta[poz] == '\n') radkuprvku--;
    if (poz == 0)
     NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
   }
  if (novaveta[poz+1] != 0) { //jestli se tam vejde alespon cast
    poz+=2;   //(protoze to skoncilo znak pred enterem)
    radkuprvku=(pozice_y-nahore)/vyskaznaku; pozice_y-= radkuprvku*vyskaznaku;
    g_MfcDlghlavniokno.policka[pozice]->SetWindowText(novaveta+poz);
    ZMEN_POZICI_PRVKU(g_MfcDlghlavniokno.policka[pozice]->m_hWnd, vlevo, pozice_y);
    ZMEN_VELIKOST_PRVKU(g_MfcDlghlavniokno.policka[pozice]->m_hWnd, vpravo-vlevo, vyskaznaku*radkuprvku);
    ShowWindow(g_MfcDlghlavniokno.policka[pozice]->m_hWnd,SW_SHOW);
    pozice--;
   }

  UVOLNI(novaveta);
  if (zobrazenychvet == 100) zobrazenychvet=99-pozice;

  KONEC:
  if (zmenavelikosti == 0 && prvnispusteni == 0) {  //pri zmene velikosti neni zakaz prekresleni (strasne to blika)
    SendMessage(g_HWNDhlavnihookna,WM_SETREDRAW,(WPARAM)TRUE,(LPARAM)0);
                //musim prekreslit vety
    rozmery.left=vlevo; rozmery.right=vpravo; rozmery.top=nahore; rozmery.bottom=dole;
    InvalidateRect(g_HWNDhlavnihookna,&rozmery,FALSE);
                //a taky radek, kam pise vety clovek
    InvalidateRect(GetDlgItem(g_HWNDhlavnihookna,IDC_VETA),NULL,FALSE);
   }

  g_poslednich100vet.pocetzobrazenychvet = zobrazenychvet;
  prvnispusteni=0;
 }

void PREKRESLI_PRVKY_V_OKNE_PRI_ZMENE_VELIKOSTI(int puvodni_x,int puvodni_y) {
RECT vel,velobj;
HWND objekt;
int zmenasirky,zmenavysky,korekcex,korekcey;
static int puvsirka,puvvyska;
static BYTE poprve=1;

  if (puvodni_x != 0) {      //uvodni inicializace puvodni sirky a vysky
    puvsirka=puvodni_x; puvvyska=puvodni_y;
    return;
   }

  GetClientRect(g_HWNDhlavnihookna,&vel);

  if (vel.right > 0 && vel.bottom > 0) {     //pokud se okno neminimalizuje
    zmenasirky=vel.right-puvsirka;
    zmenavysky=vel.bottom-puvvyska;
   }
  else {
    zmenasirky=0; zmenavysky=0;
   }

  if (poprve == 0) g_CWndhlavnihookna->SetRedraw(FALSE);

  if (zmenasirky != 0 || zmenavysky != 0) {
    PREFORMATUJ_TEXTY_CLOVEKA_A_POCITACE_NA_OBRAZOVCE(1);
   }

  objekt=GetDlgItem(g_HWNDhlavnihookna,IDC_EFEKTPROGRES1);
  ZMEN_POZICI_PRVKU(objekt,0,0); GetWindowRect(objekt,&velobj);
  korekcex=velobj.left; korekcey=velobj.top; //tady se urci korekce
  // (tedy rozdil mezi 0. pixelem okna a 0. pixelem vykreslovaci plochy)
  ZMEN_VELIKOST_PRVKU(objekt,6,vel.bottom+korekcey);

  objekt=GetDlgItem(g_HWNDhlavnihookna,IDC_EFEKTPROGRES2); GetWindowRect(objekt,&velobj);
  ZMEN_POZICI_PRVKU(objekt,vel.right-6,0);
  ZMEN_VELIKOST_PRVKU(objekt,6,vel.bottom+korekcey);

  objekt=GetDlgItem(g_HWNDhlavnihookna,IDC_NOVAVETA); GetWindowRect(objekt,&velobj);
  ZMEN_POZICI_PRVKU(objekt,vel.right-OKRAJE-(velobj.right-velobj.left)-10,vel.bottom-OKRAJE-(velobj.bottom-velobj.top)-2);

  objekt=GetDlgItem(g_HWNDhlavnihookna,IDC_VETA); GetWindowRect(objekt,&velobj);
  ZMEN_POZICI_PRVKU(objekt,velobj.left-korekcex,vel.bottom-OKRAJE-(velobj.bottom-velobj.top)-2);
  ZMEN_VELIKOST_PRVKU(objekt,velobj.right-velobj.left+zmenasirky,velobj.bottom-velobj.top);

  objekt=GetDlgItem(g_HWNDhlavnihookna,IDC_NAPISTVAVETA); GetWindowRect(objekt,&velobj);
  ZMEN_POZICI_PRVKU(objekt,OKRAJE+10,vel.bottom-OKRAJE-(velobj.bottom-velobj.top));
  
  objekt=GetDlgItem(g_HWNDhlavnihookna,IDC_NADPIS1); GetWindowRect(objekt,&velobj);
  ZMEN_POZICI_PRVKU(objekt,OKRAJE,OKRAJE-3);

  objekt=GetDlgItem(g_HWNDhlavnihookna,IDC_NADPIS2); GetWindowRect(objekt,&velobj);
  ZMEN_POZICI_PRVKU(objekt,(vel.right-OKRAJE-(velobj.right-velobj.left))/2,OKRAJE-5);

  objekt=GetDlgItem(g_HWNDhlavnihookna,IDC_NADPIS3); GetWindowRect(objekt,&velobj);
  ZMEN_POZICI_PRVKU(objekt,vel.right-OKRAJE-(velobj.right-velobj.left),OKRAJE-3);

  if (poprve == 0) g_CWndhlavnihookna->SetRedraw(TRUE);
  else poprve=0;

  PREKRESLI_OBRAZOVKU();

  if (vel.right > 0 && vel.bottom > 0) {     //pokud se okno neminimalizuje
    puvsirka=vel.right; puvvyska=vel.bottom;
   }
 }

void JDI_NA_WWW_STRANKU(char *adresa) {
char *hlaska=NULL,*prohlizec=NULL,*soubor=NULL;
DWORD vysledek;

  prohlizec=ALOKUJ_RETEZEC(MAX_PATH+1);
  soubor=ALOKUJ_RETEZEC(MAX_PATH+1);

  GetModuleFileName(NULL,soubor,MAX_PATH);
  strcpy(strrchr(soubor,'\\')+1,JMENO_SOUBORU_S_NAPOVEDOU);

  vysledek=(DWORD)FindExecutable(soubor,NULL,prohlizec);
  if (vysledek <= 32) {             //neznama chyba, ale jede se dal
    strcpy(prohlizec,adresa);
    UVOLNI(soubor); soubor=NULL;
   }
  else strcpy(soubor,adresa);
  ShellExecute(NULL,"open",prohlizec,soubor,NULL,SW_MAXIMIZE);
  if (vysledek <= 32) {
    hlaska=ALOKUJ_RETEZEC(500);
    sprintf(hlaska,"Bohužel, z jakéhosi pro mě záhadného důvodu ti nemůžu zobrazit www stránku s informacemi o IQ Pokydu.\r\n\r\nBuď nemáš nainstalovaný žádný internetový prohlížeč nebo nevím. Každopádně informace nalezneš na \"%s\".",adresa);
    NAHLAS_CHYBU(hlaska,0,_JINA_CHYBA_,_POKRACOVAT_);
    UVOLNI(hlaska);
   }
  UVOLNI(prohlizec);
  if (soubor != NULL) UVOLNI(soubor);
 }

void NAPIS_FORMATOVANY_TEXT_NAPOVEDY(char *formatovanytext,HWND policko) {
char *holytext=ALOKUJ_RETEZEC(strlen(formatovanytext)+1);
int pozice1,pozice2,konecnapozice;
BYTE tucne,podtrzene,zvyraznene,velike;
CHARFORMAT2 chf;

  for (pozice1=0,pozice2=0; formatovanytext[pozice1] != 0; pozice1++) {
    if (formatovanytext[pozice1] != '<') {
      holytext[pozice2]=formatovanytext[pozice1]; pozice2++;
     }
    else while (formatovanytext[pozice1] != '>') pozice1++;
   }
  holytext[pozice2]=0;

  SetWindowText(policko,holytext);

  tucne=0; podtrzene=0; zvyraznene=0; velike=0;

  for (pozice1=0,pozice2=0; formatovanytext[pozice1] != 0; pozice1++) {
    if (formatovanytext[pozice1] != '<') pozice2++;
    else {
      if (strncmp(formatovanytext+pozice1,"<b>",3) == 0) tucne=1;
      else if (strncmp(formatovanytext+pozice1,"</b>",4) == 0) tucne=0;
      else if (strncmp(formatovanytext+pozice1,"<u>",3) == 0) podtrzene=1;
      else if (strncmp(formatovanytext+pozice1,"</u>",4) == 0) podtrzene=0;
      else if (strncmp(formatovanytext+pozice1,"<c>",3) == 0) zvyraznene=1;
      else if (strncmp(formatovanytext+pozice1,"</c>",4) == 0) zvyraznene=0;
      else if (strncmp(formatovanytext+pozice1,"<h>",3) == 0) velike=1;
      else if (strncmp(formatovanytext+pozice1,"</h>",4) == 0) velike=0;
      else NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);

      while (formatovanytext[pozice1] != '>') pozice1++;   //dojeti na konec tagu
      if (formatovanytext[pozice1+1] == '<') continue;  //hned za tim je dalsi tag
      else pozice1++;  //preskoceni '>'
     }
    for (konecnapozice=0; formatovanytext[pozice1+konecnapozice] != '<' &&
                          formatovanytext[pozice1+konecnapozice] != 0;
          konecnapozice++);  //preskoceni stale stejneho textu

    SendMessage(policko,EM_SETSEL,(WPARAM)pozice2,(LPARAM)(pozice2+konecnapozice));
    pozice2+=konecnapozice;
    pozice1+=konecnapozice-1;

    ZeroMemory(&chf,sizeof(chf));
    chf.cbSize=sizeof(chf);
    chf.dwMask=CFM_BACKCOLOR | CFM_UNDERLINETYPE | CFM_WEIGHT | CFM_SIZE;

    if (podtrzene == 1) chf.bUnderlineType=CFU_UNDERLINEDOUBLE; else chf.bUnderlineType=CFU_UNDERLINENONE;
    if (zvyraznene == 1) chf.crBackColor=0x00FFE0D0; else chf.crBackColor=0xFFFFFF;
    if (tucne == 1) chf.wWeight=FW_BOLD; else chf.wWeight=FW_NORMAL;
    if (velike == 1) chf.yHeight=350; else chf.yHeight=220;
    SendMessage(policko, EM_SETCHARFORMAT, (WPARAM)SCF_SELECTION, (LPARAM)&chf);
   }

  SendMessage(policko,EM_SETSEL,(WPARAM)-1,(LPARAM)0);

  UVOLNI(holytext);
 }
