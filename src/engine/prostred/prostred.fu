CString _NAJDI_BASNICKE_SLOVO(char *koncovka) {
CString odpoved;
DWORD pozice1,pozice2,nejvyssi;
DWORD delkaodpovedi,delkated;
WORD kolikhledat;
char *hledane=ALOKUJ_RETEZEC(strlen(koncovka)+2);
char *nalezeno=ALOKUJ_RETEZEC(DELKA_JEDNODUCHEHO_SLOVA);
char *odpovedchar=ALOKUJ_RETEZEC(50);

  strcpy(hledane,koncovka); UPRAV_SLOVO_PRO_IQPOKYD(hledane);
  strcat(hledane,":"); kolikhledat=strlen(hledane);
  ZAKODUJ_SLOVO_V_PAMETI(hledane);
  strcpy(odpovedchar,"Žádná slova nenalezena"); delkaodpovedi=0;
  for (g_aktualnipismeno=0; g_aktualnipismeno < POCET_DVOJPISMEN; g_aktualnipismeno++) {
    nejvyssi=g_pocetslovvuplnedatabazi[g_aktualnipismeno];
    for (pozice1=0; pozice1 < nejvyssi; pozice1++) {
      for (pozice2=0; g_databazeuplnychslov[g_aktualnipismeno][pozice1][pozice2] != ZAKODOVANY_ZNAK(':'); pozice2++) {
        if (strncmp(g_databazeuplnychslov[g_aktualnipismeno][pozice1]+pozice2,hledane,kolikhledat) == 0) {
          strncpy(nalezeno,g_databazeuplnychslov[g_aktualnipismeno][pozice1],kolikhledat+pozice2-1);
          nalezeno[kolikhledat+pozice2-1]=0;
          DEKODUJ_SLOVO_V_PAMETI(nalezeno);
          ODUPRAV_SLOVO_PRO_IQPOKYD(nalezeno);
          delkated=strlen(nalezeno);
          odpovedchar=(char *)REALOKUJ_PAMET((void *)odpovedchar,delkaodpovedi+delkated+3);
          strcpy(odpovedchar+delkaodpovedi,nalezeno);
          delkaodpovedi+=delkated;
          strcpy(odpovedchar+delkaodpovedi,"\r\n");
          delkaodpovedi+=2;
         }
       }
     }
   }

  if (delkaodpovedi >= 2) odpovedchar[delkaodpovedi-2]=0;
                              //smazani enteru na konci

  UVOLNI(nalezeno);
  UVOLNI(hledane);
  odpoved=odpovedchar;
  UVOLNI(odpovedchar);
  return(odpoved);
 }

BYTE ZKONTROLUJ_SPRAVNOST_ZNAKU_VE_JMENE(CString &cjmeno) {
char *jmeno=ALOKUJ_RETEZEC(cjmeno.GetLength()+1);
int pozice1,pozice2;
  strcpy(jmeno,cjmeno);
  for (pozice1=0; jmeno[pozice1] <= ' ' && jmeno[pozice1] > 0; pozice1++);
                       //oriznuti retezce
  if (pozice1 != 0) strcpy(jmeno,jmeno+pozice1);

  for (pozice1=0; jmeno[pozice1] != 0; pozice1++) {
    if (jmeno[pozice1] > 0 && jmeno[pozice1] <= ' ') {  //chyba
      for (pozice2=pozice1+1; jmeno[pozice2] != 0; pozice2++) {
                          //zkusi se, jestli se to nema jen oriznout
        if (jmeno[pozice2] < 0 || jmeno[pozice2] > ' ') {
          UVOLNI(jmeno); return(0);           //ted uz je fakt chyba
         }
       }
      jmeno[pozice1]=0;         //ma se to jen uriznout
      break;//to tu ani nemusi byt, stejne je na konci, ale pro prehlednost...
     }
   }

  cjmeno=jmeno;

  UVOLNI(jmeno);
  return(1);        //v poradku
 }

void ROZEBER_PRIKAZOVY_RADEK(void) {
LPTSTR radekL;
char *radek,*parametry;
int pozice,delka;

  g_nastaveni.prikaz_readonlymod=0;        //standardni hodnoty
  g_nastaveni.prikaz_nezobrazovatpozadi=0;

  radekL=GetCommandLine();
  radek=ALOKUJ_RETEZEC(strlen(radekL)+2);  //pro mezeru a pro 0 na konci
  strcpy(radek,radekL);
  strcat(radek," ");     //aby se v tom lepe vyhledavalo
  parametry=strchr(radek,' ');

  for (pozice=0,delka=strlen(parametry); pozice < delka; pozice++) {
    if (parametry[pozice] == '-' || parametry[pozice] == '/') {
      if (POROVNEJ_DVA_RETEZCE(parametry+pozice+1,"readonly ",9) == 1)
       g_nastaveni.prikaz_readonlymod=1;   //Read Only mod
      if (POROVNEJ_DVA_RETEZCE(parametry+pozice+1,"bezpozadi ",10) == 1)
       g_nastaveni.prikaz_nezobrazovatpozadi=1;   //nezobrazovat pozadi
     }
   }

  UVOLNI(radek);
 }

DWORD VRAT_BARVU_TEXTU(HWND hWnd) {
int pozice;

  for (pozice=99; pozice >= 100-g_poslednich100vet.pocetzobrazenychvet; pozice--) {
    if (g_MfcDlghlavniokno.policka[pozice] != NULL
     && hWnd == g_MfcDlghlavniokno.policka[pozice]->m_hWnd) {
      if (g_poslednich100vet.puvodcevety[pozice] == 'c')
       return g_barvatextucloveka;          //clovek
      else if (g_poslednich100vet.puvodcevety[pozice] == 'p')
       return g_barvatextupocitace;         //pocitac
      else NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
     }
   }
  if (hWnd == g_HWNDhlavickovychtextu[0]
   || hWnd == g_HWNDhlavickovychtextu[2]) return g_barvahlavickovychtextu;
                           //radek s autorem, nazvem programu a KYBLSoftem

  if (hWnd == g_HWNDhlavickovychtextu[1]) return g_barvanapisuIQPokyd;

  return g_barvatextuhlavnihookna;       //vse ostatni
 }

void NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU(char *vetacloveka,char *vetapocitace) {
static BYTE prvniveta=1;
  if (prvniveta != 1) {    //pokud to neni prvni veta pocitace
    g_zaznamrozhovoru+="Člověk:  ";
    g_zaznamrozhovoru+=vetacloveka;
    g_zaznamrozhovoru+="\r\n";
    g_poslednich100vet.PRIDEJ_VETU(vetacloveka,'c');
   }
  g_zaznamrozhovoru+="Počítač: ";
  g_zaznamrozhovoru+=vetapocitace;
  g_zaznamrozhovoru+="\r\n";
  g_poslednich100vet.PRIDEJ_VETU(vetapocitace,'p');

  PREFORMATUJ_TEXTY_CLOVEKA_A_POCITACE_NA_OBRAZOVCE(0);

  prvniveta=0;
 }

//*** přetížení funkce ***
void NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU(CString vetacloveka,CString vetapocitace) {
char *clovek=NULL,*pocitac=NULL;
  clovek=ALOKUJ_RETEZEC(vetacloveka.GetLength()+1);
  strcpy(clovek,vetacloveka);

  pocitac=ALOKUJ_RETEZEC(vetapocitace.GetLength()+1);
  strcpy(pocitac,vetapocitace);

  NAPIS_VETU_S_ODPOVEDI_NA_OBRAZOVKU(clovek,pocitac);

  UVOLNI(clovek); UVOLNI(pocitac);
 }

void NASTAV_VIDITELNOST_EFEKTNICH_PROGRESSBARU(void) {
  switch(g_nastaveni.pouzivatefekty) {
    case 0: ShowWindow(GetDlgItem(g_HWNDhlavnihookna,IDC_EFEKTPROGRES1),SW_HIDE);
            ShowWindow(GetDlgItem(g_HWNDhlavnihookna,IDC_EFEKTPROGRES2),SW_HIDE);
            break;
    case 1: ShowWindow(GetDlgItem(g_HWNDhlavnihookna,IDC_EFEKTPROGRES1),SW_SHOW);
            ShowWindow(GetDlgItem(g_HWNDhlavnihookna,IDC_EFEKTPROGRES2),SW_SHOW);
            break;
   }
 }

void ZOBRAZ_HLASKU_NA_POZADI(char kterou,HWND nacem) {
        //pokud je "kterou" 0, jedna hlaska se vymaze
static BYTE pravedelano=0;
WORD pozice;
  while (pravedelano == 1) Sleep(10);    //cekani na dokonceni predchozi
  pravedelano=1;

  if (kterou == 0) {        //vymazani prvni hlasky
    for (pozice=0; g_zobrazithlasku[pozice] != 0; pozice++) {
      g_zobrazithlasku[pozice]=g_zobrazithlasku[pozice+1];
     }
   }
  else {                    //pridani hlasky na konec
    pozice=strlen(g_zobrazithlasku);
    if (pozice >= 99) NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
    if (kterou == _PREKRESLIT_OBRAZOVKU_
     && g_zobrazithlasku[pozice-1] == _PREKRESLIT_OBRAZOVKU_)
      goto KONEC;             //uz tam jedno prekresleni je
    g_zobrazithlasku[pozice]=kterou; g_zobrazithlasku[pozice+1]=0;
    g_rodichlasky=nacem;
   }
  KONEC:
  pravedelano=0;
 }

