void SKLONUJ_VZOR_PAN(BYTE pad,BYTE cislo) {
  strcpy(g_slovodocasne,g_slovozaklad);
  if (pad != 1 || cislo != 1) {
    PODM_ODSTRAN_E(g_slovodocasne);
    ZMEN_PREDPOSLEDNI_U_NA_O(g_slovodocasne);
    PODM_ODSTRAN_US(g_slovodocasne,1,2);
   }

  if (cislo == 2) goto MNOZNECISLO;
  switch(pad) {
    case 1: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_DO_FRONTY();
            break;
    case 2: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("a");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: PAD3_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ovi");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("u");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("a");
            PRIDEJ_DO_FRONTY();
            break;
    case 5: strcpy(g_slovo,g_slovodocasne);
            switch(POSLEDNI_ZNAK(g_slovo)) {
              case 'k': case '*': case 'h': case 'g': PRIDEJ_NA_KONEC("u"); break;
              case 'r': if (JELI_SOUHLASKA(g_slovo[strlen(g_slovo)-2]) == 1)
                        ZJEMNI_SLOVO_PODSTJM(); //např. bratře, ale ogare
						//pokračuje se na default
              default: PRIDEJ_NA_KONEC("e");
             }
            PRIDEJ_DO_FRONTY();
            break;
    case 6: goto PAD3_1;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("em");
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: PAD1_2:
            strcpy(g_slovo,g_slovodocasne);
            if (ZJEMNI_SLOVO_PODSTJM() == 1) {
              PRIDEJ_NA_KONEC("i");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            if (POSLEDNI_PISMENA(g_slovo,"an") == 1
             || POSLEDNI_PISMENA(g_slovo,"t") == 1)
             PRIDEJ_NA_KONEC("é");
            else PRIDEJ_NA_KONEC("ové");
            PRIDEJ_DO_FRONTY();
            break;
    case 2: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ů");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ům");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("y");
            PRIDEJ_DO_FRONTY();
            break;
    case 5: goto PAD1_2;
    case 6: strcpy(g_slovo,g_slovodocasne);
            switch(POSLEDNI_ZNAK(g_slovo)) {
              case 'k': case '*': case 'h':
                PRIDEJ_NA_KONEC("á*");
                PRIDEJ_DO_FRONTY();
                strcpy(g_slovo,g_slovodocasne);
                ZJEMNI_SLOVO_PODSTJM();
                PRIDEJ_NA_KONEC("í*");
                PRIDEJ_DO_FRONTY();
                break;
              default:
                PRIDEJ_NA_KONEC("e*");
                PRIDEJ_DO_FRONTY();
                break;
             }
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("y");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ama");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }

void SKLONUJ_VZOR_HRAD(BYTE pad,BYTE cislo) {
  strcpy(g_slovodocasne,g_slovozaklad);
  if ((pad != 1 && pad != 4) || cislo != 1) {
    OREZ_O_SAMOHLASKU(g_slovodocasne);
    PODM_ODSTRAN_E(g_slovodocasne);
    PODM_ODSTRAN_US(g_slovodocasne,2,2);
   }
  if (cislo == 2) goto MNOZNECISLO;
  switch(pad) {
    case 1: PAD1_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_DO_FRONTY();
            break;
    case 2: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("u");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("u");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: goto PAD1_1;
    case 5: strcpy(g_slovo,g_slovodocasne);
            switch(POSLEDNI_ZNAK(g_slovo)) {
              case 'k': case '*': case 'h': case 'g': PRIDEJ_NA_KONEC("u"); break;
              default: PRIDEJ_NA_KONEC("e");
             }
            PRIDEJ_DO_FRONTY();
            break;
    case 6: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("u");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            if (POSLEDNI_PISMENA(g_slovo,"k") == 0) {  //míček
              ZJEMNI_SLOVO_PODSTJM();
              PRIDEJ_NA_KONEC("e");
//#              if (POSLEDNI_ZNAK(g_slovo) != 'e');   //...tak je to asi nespisovný
                                          // tvar (např. hotel => (o) hotele)
              PRIDEJ_DO_FRONTY();
             }
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("em");
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: PAD1_2:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("y");
            PRIDEJ_DO_FRONTY();
            break;
    case 2: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ů");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ům");
            PRIDEJ_DO_FRONTY();
            break;
    case 4:
    case 5:
            goto PAD1_2;
    case 6: strcpy(g_slovo,g_slovodocasne);
            switch(POSLEDNI_ZNAK(g_slovo)) {
              case 'k': case '*': case 'h': case 'g':
                PRIDEJ_NA_KONEC("á*");
                PRIDEJ_DO_FRONTY();
                strcpy(g_slovo,g_slovodocasne);
                ZJEMNI_SLOVO_PODSTJM();
                PRIDEJ_NA_KONEC("í*");
                PRIDEJ_DO_FRONTY();
                break;
              case 'l': case 's': case 'z':
                PRIDEJ_NA_KONEC("e*");
                PRIDEJ_DO_FRONTY();
                strcpy(g_slovo,g_slovodocasne);
                PRIDEJ_NA_KONEC("í*");
                PRIDEJ_DO_FRONTY();
                break;
              default:
                PRIDEJ_NA_KONEC("e*");
                PRIDEJ_DO_FRONTY();
                break;
             }
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("y");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ama");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }

void SKLONUJ_VZOR_MUZ(BYTE pad,BYTE cislo) {
  strcpy(g_slovodocasne,g_slovozaklad);
  if (pad != 1 || cislo != 1) PODM_ODSTRAN_E_C(g_slovodocasne);
  if (cislo == 2) goto MNOZNECISLO;
  switch(pad) {
    case 1: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_DO_FRONTY();
            break;
    case 2: PAD2_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("e");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: PAD3_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("i");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ovi");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: goto PAD2_1;
    case 5: strcpy(g_slovo,g_slovodocasne);
            switch(POSLEDNI_ZNAK(g_slovo)) {
              case 'c':
                ZJEMNI_SLOVO_PODSTJM();
                PRIDEJ_NA_KONEC("e");
                break;
              default:
                ZJEMNI_SLOVO_PODSTJM();
                PRIDEJ_NA_KONEC("i");
                break;
             }
            PRIDEJ_DO_FRONTY();
            break;
    case 6: goto PAD3_1;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("em");
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: PAD1_2:
            strcpy(g_slovo,g_slovodocasne);
            if (POSLEDNI_PISMENA(g_slovo,"el") == 1) PRIDEJ_NA_KONEC("é");
            else PRIDEJ_NA_KONEC("i");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ové");
            PRIDEJ_DO_FRONTY();
            break;
    case 2: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ů");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ům");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: goto PAD2_1;
    case 5: goto PAD1_2;
    case 6: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("í*");
            PRIDEJ_DO_FRONTY();
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("i");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ema");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }


void SKLONUJ_VZOR_STROJ(BYTE pad,BYTE cislo) {
  strcpy(g_slovodocasne,g_slovozaklad);
  if ((pad != 1 && pad != 4) || cislo != 1) PODM_ODSTRAN_E_C(g_slovodocasne);
  if (cislo == 2) goto MNOZNECISLO;
  switch(pad) {
    case 1: PAD1_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_DO_FRONTY();
            break;
    case 2: PAD2_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("e");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: PAD3_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("i");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: goto PAD1_1;
    case 5:
    case 6:
            goto PAD3_1;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("em");
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: goto PAD2_1;
    case 2: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ů");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ům");
            PRIDEJ_DO_FRONTY();
            break;
    case 4:
    case 5:
            goto PAD2_1;
    case 6: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("í*");
            PRIDEJ_DO_FRONTY();
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("i");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ema");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }

void SKLONUJ_VZOR_PREDSEDA(BYTE pad,BYTE cislo) {
  strcpy(g_slovodocasne,g_slovozaklad);
  OREZ_O_SAMOHLASKU(g_slovodocasne);
  if (cislo == 2) goto MNOZNECISLO;
  switch(pad) {
    case 1: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("a");
            PRIDEJ_DO_FRONTY();
            break;
    case 2: PAD2_1:
            strcpy(g_slovo,g_slovodocasne);
            if (MEKKA_SOUHLASKA(POSLEDNI_ZNAK(g_slovo)) == 1) PRIDEJ_NA_KONEC("i");
            else PRIDEJ_NA_KONEC("y");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: PAD3_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ovi");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("u");
            PRIDEJ_DO_FRONTY();
            break;
    case 5: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("o");
            PRIDEJ_DO_FRONTY();
            break;
    case 6: goto PAD3_1;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ou");
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: PAD1_2:
            strcpy(g_slovo,g_slovodocasne);
            if (POSLEDNI_PISMENA(g_slovozaklad,"ta") == 1 || POSLEDNI_PISMENA(g_slovozaklad,"da") == 1) {
              ZJEMNI_SLOVO_PODSTJM();
              PRIDEJ_NA_KONEC("i");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
              if (POSLEDNI_PISMENA(g_slovozaklad,"eta") == 1 || POSLEDNI_PISMENA(g_slovozaklad,"ota") == 1)
               PRIDEJ_NA_KONEC("ové");
              else PRIDEJ_NA_KONEC("é");
             }
            else {
              PRIDEJ_NA_KONEC("ové");
             }
            PRIDEJ_DO_FRONTY();
            break;
    case 2: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ů");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ům");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: goto PAD2_1;
    case 5: goto PAD1_2;
    case 6: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("e*");
            PRIDEJ_DO_FRONTY();
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("y");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ama");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }

void SKLONUJ_VZOR_SOUDCE(BYTE pad,BYTE cislo) {
  strcpy(g_slovodocasne,g_slovozaklad);
  OREZ_O_SAMOHLASKU(g_slovodocasne);
  if (cislo == 2) goto MNOZNECISLO;
  switch(pad) {
    case 1: PAD1_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("e");
            PRIDEJ_DO_FRONTY();
            break;
    case 2: goto PAD1_1;
    case 3: PAD3_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("i");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ovi");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: goto PAD1_1;
    case 5: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("e");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            if (ZJEMNI_SLOVO_PODSTJM() == 1) {      //nespisovne, ale pouzivane
              PRIDEJ_NA_KONEC("e");
              PRIDEJ_DO_FRONTY();
             }
            break;
    case 6: goto PAD3_1;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("em");
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: PAD1_2:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("i");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ové");
            PRIDEJ_DO_FRONTY();
            break;
    case 2: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ů");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ům");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: goto PAD1_1;
    case 5: goto PAD1_2;
    case 6: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("í*");
            PRIDEJ_DO_FRONTY();
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("i");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ema");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }

void SKLONUJ_VZOR_ZENA(BYTE pad,BYTE cislo) {
  strcpy(g_slovodocasne,g_slovozaklad);
  OREZ_O_SAMOHLASKU(g_slovodocasne);
  if (cislo == 2) goto MNOZNECISLO;
  switch(pad) {
    case 1: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("a");
            PRIDEJ_DO_FRONTY();
            break;
    case 2: PAD2_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("y");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            if (MEKKA_SOUHLASKA(POSLEDNI_ZNAK(g_slovo)) == 1) {
              PRIDEJ_NA_KONEC("i");
              PRIDEJ_DO_FRONTY();
             }
            break;
    case 3: PAD3_1:
            strcpy(g_slovo,g_slovodocasne);
            ZJEMNI_SLOVO_PODSTJM();
            PRIDEJ_NA_KONEC("e");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("u");
            PRIDEJ_DO_FRONTY();
            break;
    case 5: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("o");
            PRIDEJ_DO_FRONTY();
            break;
    case 6: goto PAD3_1;
    case 7: strcpy(g_slovo,g_slovodocasne);
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,1) == 1) {
              PRIDEJ_NA_KONEC("ou");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            PRIDEJ_NA_KONEC("ou");
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: goto PAD2_1;
    case 2: strcpy(g_slovo,g_slovodocasne);
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,1+8) == 1) {
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);		//hrubě nespisovné
             }
            else PODM_VLOZ_E(g_slovo,1,2);
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,1) == 1) {
              PRIDEJ_NA_KONEC("ám");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            PRIDEJ_NA_KONEC("ám");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: goto PAD2_1;
    case 5: goto PAD2_1;
    case 6: strcpy(g_slovo,g_slovodocasne);
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,1) == 1) {
              PRIDEJ_NA_KONEC("á*");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            PRIDEJ_NA_KONEC("á*");
            PRIDEJ_DO_FRONTY();
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,1) == 1) {
              PRIDEJ_NA_KONEC("ami");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            PRIDEJ_NA_KONEC("ami");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,1) == 1) {
              PRIDEJ_NA_KONEC("ama");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            PRIDEJ_NA_KONEC("ama");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }

void SKLONUJ_VZOR_RUZE(BYTE pad,BYTE cislo) {
  strcpy(g_slovodocasne,g_slovozaklad);
  OREZ_O_SAMOHLASKU(g_slovodocasne);
  if (cislo == 2) goto MNOZNECISLO;
  switch(pad) {
    case 1: PAD1_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("e");
            PRIDEJ_DO_FRONTY();
            break;
    case 2: goto PAD1_1;
    case 3: PAD3_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("i");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: goto PAD3_1;
    case 5: goto PAD1_1;
    case 6: goto PAD3_1;
    case 7: strcpy(g_slovo,g_slovodocasne);
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,2) == 1) {
              PRIDEJ_NA_KONEC("í");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            PRIDEJ_NA_KONEC("í");
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: goto PAD1_1;
    case 2: strcpy(g_slovo,g_slovodocasne);
            if (POSLEDNI_PISMENA(g_slovo,"ic") == 1) {      //ice (např. ulice)
              PRIDEJ_DO_FRONTY();
             }
            else if (POSLEDNI_PISMENA(g_slovo,"íc") == 1) { //íce (např. plíce)
              PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,2);
              PRIDEJ_DO_FRONTY();
             }
            else if (POSLEDNI_PISMENA(g_slovo,"yň") == 1) { //yně (např. jeskyně)
              PRIDEJ_NA_KONEC("í");
              PRIDEJ_DO_FRONTY();
             }
            else if (POSLEDNI_PISMENA(g_slovo,"íl") == 1) { //íle (např. chvíle, míle)
              PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,2);
              PRIDEJ_DO_FRONTY();
             }
            else {
              if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,2) == 1) {
                PRIDEJ_NA_KONEC("í");
                PRIDEJ_DO_FRONTY();
        //následující tvar dole bude hrubě nespisovný (např. práce-(bez)prácí)
               }
             }
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("í");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,2) == 1) {
              PRIDEJ_NA_KONEC("ím");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            PRIDEJ_NA_KONEC("ím");
            PRIDEJ_DO_FRONTY();
            break;
    case 4:
    case 5:
            goto PAD1_1;
    case 6: strcpy(g_slovo,g_slovodocasne);
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,2) == 1) {
              PRIDEJ_NA_KONEC("í*");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            PRIDEJ_NA_KONEC("í*");
            PRIDEJ_DO_FRONTY();
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,2) == 1) {
              PRIDEJ_NA_KONEC("emi");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            PRIDEJ_NA_KONEC("emi");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,2) == 1) {
              PRIDEJ_NA_KONEC("ema");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            PRIDEJ_NA_KONEC("ema");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }

void SKLONUJ_VZOR_PISEN(BYTE pad,BYTE cislo) {
  strcpy(g_slovodocasne,g_slovozaklad);
  if ((pad != 1 && pad != 4) || cislo != 1) {
    PODM_ODSTRAN_E(g_slovodocasne);
    ZMEN_PREDPOSLEDNI_U_NA_O(g_slovodocasne);
   }
  if (cislo == 2) goto MNOZNECISLO;
  switch(pad) {
    case 1: PAD1_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_DO_FRONTY();
            break;
    case 2: PAD2_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("e");
            PRIDEJ_DO_FRONTY();
            switch(POSLEDNI_ZNAK(g_slovodocasne)) {	//(bez) tratě i trati
              case 'ď': case 'ť':
                strcpy(g_slovo,g_slovodocasne);
                PRIDEJ_NA_KONEC("i");
                PRIDEJ_DO_FRONTY();
             }
            break;
    case 3: PAD3_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("i");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: goto PAD1_1;
    case 5:
    case 6:
            goto PAD3_1;
    case 7: PAD7_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("í");
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: goto PAD2_1;
    case 2: goto PAD7_1;
    case 3: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ím");
            PRIDEJ_DO_FRONTY();
            break;
    case 4:
    case 5:
            goto PAD2_1;
    case 6: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("í*");
            PRIDEJ_DO_FRONTY();
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("emi");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ema");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }

void SKLONUJ_VZOR_KOST(BYTE pad,BYTE cislo) {
  strcpy(g_slovodocasne,g_slovozaklad);
