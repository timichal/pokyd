            PRIDEJ_DO_FRONTY();
            break;
   }
 }

void SKLONUJ_VZOR_MESTO(BYTE pad,BYTE cislo) {
BYTE koncovkaum;
  strcpy(g_slovodocasne,g_slovozaklad);
  OREZ_O_SAMOHLASKU(g_slovodocasne);
  koncovkaum=PODM_ODSTRAN_UM(g_slovodocasne,2);
  if (cislo == 2) goto MNOZNECISLO;
  switch(pad) {
    case 1:
    case 4:
    case 5:
            strcpy(g_slovo,g_slovodocasne);
            if (koncovkaum == 0) PRIDEJ_NA_KONEC("o");
            else PRIDEJ_NA_KONEC("um");
            PRIDEJ_DO_FRONTY();
            break;
    case 2: PAD2_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("a");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("u");
            PRIDEJ_DO_FRONTY();
            break;
    case 6: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("u");
            PRIDEJ_DO_FRONTY();

            if (POSLEDNI_ZNAK(g_slovo) != 'h'  //polínko - jen (o) polínku
             && POSLEDNI_ZNAK(g_slovo) != '*'
             && POSLEDNI_ZNAK(g_slovo) != 'k'
             && koncovkaum == 0) {
              strcpy(g_slovo,g_slovodocasne);
              ZJEMNI_SLOVO_PODSTJM();
              PRIDEJ_NA_KONEC("e");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("em");
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: goto PAD2_1;
    case 2: if (koncovkaum == 1 && JELI_SAMOHLASKA(POSLEDNI_ZNAK(g_slovodocasne)) == 1) {
              SKLONUJ_VZOR_MORE(2,2); break;
             }
            strcpy(g_slovo,g_slovodocasne);
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,4+16) == 1) {
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
             }
            else PODM_VLOZ_E(g_slovo,2,2);
            PRIDEJ_DO_FRONTY();
            break;
    case 3: if (koncovkaum == 1 && JELI_SAMOHLASKA(POSLEDNI_ZNAK(g_slovodocasne)) == 1) {
              SKLONUJ_VZOR_MORE(3,2); break;
             }
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ům");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ám");
            PRIDEJ_DO_FRONTY();
            break;
    case 4:
    case 5:
            goto PAD2_1;
    case 6: if (koncovkaum == 1 && JELI_SAMOHLASKA(POSLEDNI_ZNAK(g_slovodocasne)) == 1) {
              SKLONUJ_VZOR_MORE(6,2); break;
             }
            strcpy(g_slovo,g_slovodocasne);
            if (POSLEDNI_ZNAK(g_slovo) == 'h'  //polínko - jen (o) polínku
             || POSLEDNI_ZNAK(g_slovo) == '*'
             || POSLEDNI_ZNAK(g_slovo) == 'k') {
              PRIDEJ_NA_KONEC("á*");
              PRIDEJ_DO_FRONTY();
              strcpy(g_slovo,g_slovodocasne);
              if (POSLEDNI_ZNAK(g_slovo) != 'k') {
                ZJEMNI_SLOVO_PODSTJM();
                PRIDEJ_NA_KONEC("í*");
                PRIDEJ_DO_FRONTY();
               }
             }
            else {
              strcpy(g_slovo,g_slovodocasne);
              PRIDEJ_NA_KONEC("e*");
              PRIDEJ_DO_FRONTY();
             }
            break;
    case 7: if (koncovkaum == 1 && JELI_SAMOHLASKA(POSLEDNI_ZNAK(g_slovodocasne)) == 1) {
              SKLONUJ_VZOR_MORE(7,2); break;
             }
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("y");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ama");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ami");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }

void SKLONUJ_VZOR_MORE(BYTE pad,BYTE cislo) {
  strcpy(g_slovodocasne,g_slovozaklad);
  OREZ_O_SAMOHLASKU(g_slovodocasne);
  PODM_ODSTRAN_UM(g_slovodocasne,2);     //kvuli volani funkce z funkce
                                       //SKLONUJ_VZOR_MESTO v nekterych padech
  if (cislo == 2) goto MNOZNECISLO;
