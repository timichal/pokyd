    case 5:
            goto PAD1_1;
    case 6: goto PAD3_1;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("em");
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: goto PAD1_1;
    case 2: strcpy(g_slovo,g_slovodocasne);
            if (POSLEDNI_PISMENA(g_slovo,"išť") == 1) {
              PRIDEJ_DO_FRONTY(); break;        //hřiště => (bez) hřišť atd.
             }
            if (PODM_ZKRAT_SAMOHLASKU_ODZADU(g_slovo,2,4) == 1) {
              PRIDEJ_NA_KONEC("í");
              PRIDEJ_DO_FRONTY();
             }
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("í");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ím");
            PRIDEJ_DO_FRONTY();
            break;
    case 4:
    case 5:
            goto PAD1_1;
    case 6: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("í*");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("e*");               //nespisovny tvar
            PRIDEJ_DO_FRONTY();
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("i");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ema");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("emi");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }

