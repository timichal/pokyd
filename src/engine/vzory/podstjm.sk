            PRIDEJ_NA_KONEC("i");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ji");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: PAD3_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ji");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("e");
            PRIDEJ_DO_FRONTY();
            break;
    case 4: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("u");
            PRIDEJ_DO_FRONTY();
            break;
    case 5: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("o");
            PRIDEJ_DO_FRONTY();
            break;
    case 6: goto PAD3_1;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ou");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("jí");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("í");
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: PAD1_2:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("y");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("je");
            PRIDEJ_DO_FRONTY();
            break;
    case 2: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("jí");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("í");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ám");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("jím");
            PRIDEJ_DO_FRONTY();
            break;
    case 4:
    case 5:
            goto PAD1_2;
    case 6: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("á*");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("jí*");
            PRIDEJ_DO_FRONTY();
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ami");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("jemi");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("jema");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("emi");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ema");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }

void SKLONUJ_VZOR_TEMA(BYTE pad,BYTE cislo) {
  strcpy(g_slovodocasne,g_slovozaklad);
  if (cislo == 2) goto MNOZNECISLO;
  switch(pad) {
    case 1: PAD1_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_DO_FRONTY();
            break;
    case 2: PAD2_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ta");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_DO_FRONTY();
            break;
    case 3: PAD3_1:
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("tu");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_DO_FRONTY();
            break;
    case 4:
    case 5:
            goto PAD1_1;
    case 6: goto PAD3_1;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("tem");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_DO_FRONTY();
            break;
   }
  return;
  MNOZNECISLO:
  switch(pad) {
    case 1: goto PAD2_1;
    case 2: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("t");
            PRIDEJ_DO_FRONTY();
            break;
    case 3: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("tům");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("tám");
            PRIDEJ_DO_FRONTY();
            break;
    case 4:
    case 5:
            goto PAD2_1;
    case 6: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("te*");
            PRIDEJ_DO_FRONTY();
            break;
    case 7: strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("ty");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("tama");
            PRIDEJ_DO_FRONTY();
            strcpy(g_slovo,g_slovodocasne);
            PRIDEJ_NA_KONEC("tami");
            PRIDEJ_DO_FRONTY();
            break;
   }
 }


void SKLONUJ_VZOR_KALHOTY(BYTE pad) {
  SKLONUJ_VZOR_ZENA(pad,2);

  if (pad == 3) {
    strcpy(g_slovo,g_slovozaklad);
    OREZ_O_SAMOHLASKU(g_slovo);
    PRIDEJ_NA_KONEC("ům");
    PRIDEJ_DO_FRONTY();
   }
  if (pad == 6) {
    strcpy(g_slovo,g_slovozaklad);
    OREZ_O_SAMOHLASKU(g_slovo);
    switch (POSLEDNI_ZNAK(g_slovo)) {
      case 'h': case '*': case 'k':
        break;                                //(o) Čechech atd. je blbost
      case 'l': case 's': case 'z':           //(o) Neumětelích, ale můžou být
                                              //i ostatní tvary
        strcpy(g_slovo,g_slovozaklad);
        OREZ_O_SAMOHLASKU(g_slovo);
        PRIDEJ_NA_KONEC("í*");
        PRIDEJ_NA_ZACATEK_FRONTY();
        goto ECH;
      case 'n': case 'd': VYMAZ_FRONTU();     //(o) Vinohradách je blbost
                          goto ECH;
      default: ECH:
        strcpy(g_slovo,g_slovozaklad);
        OREZ_O_SAMOHLASKU(g_slovo);
        PRIDEJ_NA_KONEC("e*");
        PRIDEJ_DO_FRONTY();
     }
   }
  if (pad == 7) {
    strcpy(g_slovo,g_slovozaklad);
    OREZ_O_SAMOHLASKU(g_slovo);
    PRIDEJ_NA_KONEC("y");
    PRIDEJ_NA_ZACATEK_FRONTY();
   }
 }

void SKLONUJ_VZOR_DATA(BYTE pad) {
  SKLONUJ_VZOR_MESTO(pad,2);
 }

void SKLONUJ_VZOR_HOUSLE(BYTE pad) {
  SKLONUJ_VZOR_RUZE(pad,2);

  strcpy(g_slovo,g_slovozaklad);
  OREZ_O_SAMOHLASKU(g_slovo);
  if (POSLEDNI_PISMENA(g_slovo,"oc") == 1) {      //vánoce, velikonoce
    if (pad == 2) {
      PRIDEJ_NA_ZACATEK_FRONTY();
     }
    if (pad == 3) {
      PRIDEJ_NA_KONEC("ům");
      PRIDEJ_NA_ZACATEK_FRONTY();
     }
    if (pad == 7) {
      PRIDEJ_NA_KONEC("i");
      PRIDEJ_DO_FRONTY();
     }
   }
 }

void SKLONUJ_VZOR_KUPE(void) {
  strcpy(g_slovavefronte,g_slovozaklad);
 }
