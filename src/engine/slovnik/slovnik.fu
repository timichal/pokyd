                ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
                VYTVOR_IDENTIFIKACI_TVARU_SLOVA(_vztazna_,0,ident_tvaru); //...i vztazne
                ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();

                if (rod == 1 && ((pad == 4 && cislo == 1) || ((pad == 1 || pad == 5) && cislo == 2)));
                else break;              //zivotnost pouze ve 2 pripadech
               }
             }
           }
         }
       }
      ZAPIS_VNOROVANI(0);

      ZAPIS_VNOROVANI('5');                         //zajmena vztazna
      for (rod=1; rod <= 2; rod++) {               //jenž
        for (cislo=1; cislo <= 2; cislo++) {
          for (pad=1; pad <= 7; pad++) {
            for (umisteni=1; umisteni <= 2; umisteni++) {
              for (zivotnost=0; zivotnost <= 1; zivotnost++) {
