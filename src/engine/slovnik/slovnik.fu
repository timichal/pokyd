                SKLONUJ_ZAJMENA_VZTAZNA(pad,cislo,rod,zivotnost,umisteni,6);

                ident_tvaru[0]=0;
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_pad_,pad);
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_osoba_,3);
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cislo_,cislo);
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_rod_,rod);
                if (rod == 1 && ((pad == 4 && cislo == 1) || ((pad == 1 || pad == 5) && cislo == 2))) {
                  VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_zivotnost_,zivotnost);
                 }
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_tvar_,6);
                VYTVOR_IDENTIFIKACI_TVARU_SLOVA(_vztazna_,0,ident_tvaru);

                ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
                if (rod == 1 && ((pad == 4 && cislo == 1) || ((pad == 1 || pad == 5) && cislo == 2)));
                else break;              //zivotnost pouze ve 2 pripadech
               }
             }
           }
         }
       }

      for (pad=1; pad <= 7; pad++) {                      //což
        VYMAZ_FRONTU();
        SKLONUJ_ZAJMENA_VZTAZNA(pad,1,1,0,1,7);

        ident_tvaru[0]=0;
        VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_pad_,pad);
