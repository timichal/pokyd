        VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_tvar_,7);
        VYTVOR_IDENTIFIKACI_TVARU_SLOVA(_vztazna_,0,ident_tvaru);

        ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
       }
      ZAPIS_VNOROVANI(0);

      ZAPIS_VNOROVANI('6');                        //zajmena neurcita
      for (pridavek=1; pridavek <= 7; pridavek++) {      //někdo, něco
        for (tvar=1; tvar <= 2; tvar++) {
          for (pad=1; pad <= 7; pad++) {
            VYMAZ_FRONTU();
            SKLONUJ_ZAJMENA_NEURCITA(pad,1,1,0,tvar,pridavek);

            ident_tvaru[0]=0;
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_pad_,pad);
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_osoba_,3);
           if (tvar == 1)        //kdo - mužského rodu
             VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_rod_,1);
            else                  //co - středního rodu
             VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_rod_,3);

            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_tvar_,tvar);
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_pridavek_,pridavek);
            VYTVOR_IDENTIFIKACI_TVARU_SLOVA(_neurcita_,0,ident_tvaru);

            ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
           }
         }
       }

      for (pridavek=1; pridavek <= 7; pridavek++) {   //nějaký, některý, něčí
        for (tvar=3; tvar <= 5; tvar++) {
          if (pridavek == 6 && tvar == 5) continue;  //neexistuje: kdečí
          for (rod=1; rod <= 3; rod++) {
            for (cislo=1; cislo <= 2; cislo++) {
              for (pad=1; pad <= 7; pad++) {
                for (zivotnost=0; zivotnost <= 1; zivotnost++) {
                  VYMAZ_FRONTU();
                  SKLONUJ_ZAJMENA_NEURCITA(pad,cislo,rod,zivotnost,tvar,pridavek);

                  ident_tvaru[0]=0;
                  VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_pad_,pad);
                  VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_osoba_,3);
                  VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cislo_,cislo);
                  VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_rod_,rod);
                  if (rod == 1 && ((pad == 4 && cislo == 1) || ((pad == 1 || pad == 5) && cislo == 2))) {
                    VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_zivotnost_,zivotnost);
                   }
                  VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_tvar_,tvar);
                  VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_pridavek_,pridavek);
                  VYTVOR_IDENTIFIKACI_TVARU_SLOVA(_neurcita_,0,ident_tvaru);

                  ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
                  if (rod == 1 && ((pad == 4 && cislo == 1) || ((pad == 1 || pad == 5) && cislo == 2)));
                  else break;              //zivotnost pouze ve 2 pripadech
                 }
               }
             }
           }
         }
       }

      for (tvar=6; tvar <= 7; tvar++) {                //každý, všechen
        for (rod=1; rod <= 3; rod++) {
          for (cislo=1; cislo <= 2; cislo++) {
            for (pad=1; pad <= 7; pad++) {
              for (zivotnost=0; zivotnost <= 1; zivotnost++) {
                VYMAZ_FRONTU();
                SKLONUJ_ZAJMENA_NEURCITA(pad,cislo,rod,zivotnost,tvar,pridavek);

                ident_tvaru[0]=0;
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_pad_,pad);
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_osoba_,3);
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cislo_,cislo);
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_rod_,rod);
                if (rod == 1 && ((pad == 4 && cislo == 1) || ((pad == 1 || pad == 5) && cislo == 2))) {
                  VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_zivotnost_,zivotnost);
                 }
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_tvar_,tvar);
                VYTVOR_IDENTIFIKACI_TVARU_SLOVA(_neurcita_,0,ident_tvaru);

                ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
                if (rod == 1 && ((pad == 4 && cislo == 1) || ((pad == 1 || pad == 5) && cislo == 2)));
                else break;              //zivotnost pouze ve 2 pripadech
               }
             }
           }
         }
       }
      ZAPIS_VNOROVANI(0);

      ZAPIS_VNOROVANI('7');                          //zajmena zaporna
      for (tvar=1; tvar <= 2; tvar++) {               //nikdo, nic
        for (pad=1; pad <= 7; pad++) {
          VYMAZ_FRONTU();
          SKLONUJ_ZAJMENA_ZAPORNA(pad,1,1,0,tvar);

          ident_tvaru[0]=0;
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_pad_,pad);
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_osoba_,3);
          if (tvar == 1)        //kdo - mužského rodu
           VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_rod_,1);
          else                  //co - středního rodu
           VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_rod_,3);

          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_tvar_,tvar);
          VYTVOR_IDENTIFIKACI_TVARU_SLOVA(_zaporna_,0,ident_tvaru);

          ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
         }
       }

      for (tvar=3; tvar <= 5; tvar++) {        //nijaký, žádný, ničí
        for (rod=1; rod <= 3; rod++) {
          for (cislo=1; cislo <= 2; cislo++) {
            for (pad=1; pad <= 7; pad++) {
              for (zivotnost=0; zivotnost <= 1; zivotnost++) {
                VYMAZ_FRONTU();
                SKLONUJ_ZAJMENA_ZAPORNA(pad,cislo,rod,zivotnost,tvar);

                ident_tvaru[0]=0;
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_pad_,pad);
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_osoba_,3);
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cislo_,cislo);
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_rod_,rod);
                if (rod == 1 && ((pad == 4 && cislo == 1) || ((pad == 1 || pad == 5) && cislo == 2))) {
                  VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_zivotnost_,zivotnost);
                 }
                VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_tvar_,tvar);
                VYTVOR_IDENTIFIKACI_TVARU_SLOVA(_zaporna_,0,ident_tvaru);

                ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
                if (rod == 1 && ((pad == 4 && cislo == 1) || ((pad == 1 || pad == 5) && cislo == 2)));
                else break;              //zivotnost pouze ve 2 pripadech
               }
             }
           }
         }
       }
      break;

    case 4:                                //cislovky - jsou jen nektere//!!!
      for (cislovka=0; cislovka <= 1008;) {
        for (cislo=1; cislo <= 2; cislo++) {
          for (pad=1; pad <= 7; pad++) {
            VYMAZ_FRONTU();
            if (SKLONUJ_CISLA(pad,cislo,cislovka) == 0) continue;

            ident_tvaru[0]=0;
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_pad_,pad);
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cislo_,cislo);
            VYTVOR_IDENTIFIKACI_TVARU_SLOVA(55,id_slova,ident_tvaru);

            ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
           }
         }
        if (cislovka < 20) cislovka++;
        else if (cislovka < 100) cislovka+=10;
        else if (cislovka < 1000) cislovka+=100;
        else cislovka++;
       }
      break;
    case 5:                                //slovesa
      for (rod=1; rod <= 3; rod++) {                 //minuly cas
        for (cislo=1; cislo <= 2; cislo++) {
          for (zivotnost=0; zivotnost <= 1; zivotnost++) {

            ident_tvaru[0]=0;
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cislo_,cislo);
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cas_,1);
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_rod_,rod);
            if (cislo == 2 && rod == 1) {
              VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_zivotnost_,zivotnost);
             }
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_vid_,vid);
            VYTVOR_IDENTIFIKACI_TVARU_SLOVA(vzor,id_slova,ident_tvaru);

            if (ZJISTI_ZDA_JDE_O_VYJIMKU_SLOVA(ident_tvaru) == 0) {
              if (SKLONUJ_SLOVESA(vzor,1,cislo,1,rod,vid,zivotnost,0,0,"","") == 0) goto KONECCYKLU51;
             }
            ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();

            KONECCYKLU51:
            if (cislo == 2 && rod == 1);
            else break;          //zivotnost je pouze v 1 pripade
           }
         }
       }

      if (vid == 0) cas=2;     //pri nedokonavem vidu je pouze pritomny cas
      else cas=3;              //a pri dokonavem vidu je pouze budouci cas

      for (cislo=1; cislo <= 2; cislo++) {
        for (osoba=1; osoba <= 3; osoba++) {

          ident_tvaru[0]=0;
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_osoba_,osoba);
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cislo_,cislo);
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cas_,cas);
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_vid_,vid);
          VYTVOR_IDENTIFIKACI_TVARU_SLOVA(vzor,id_slova,ident_tvaru);

          if (ZJISTI_ZDA_JDE_O_VYJIMKU_SLOVA(ident_tvaru) == 0) {
            if (SKLONUJ_SLOVESA(vzor,osoba,cislo,cas,1,vid,0,0,0,"","") == 0) continue;
           }
          ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
         }
       }

      for (cislo=1; cislo <= 2; cislo++) {                    //rozkaz
        for (osoba=1; osoba <= 2; osoba++) {
          if (osoba == 1 && cislo == 1) continue;        //neexistuje tvar

          ident_tvaru[0]=0;
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_osoba_,osoba);
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cislo_,cislo);
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cas_,4);
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_vid_,vid);
          VYTVOR_IDENTIFIKACI_TVARU_SLOVA(vzor,id_slova,ident_tvaru);

          if (ZJISTI_ZDA_JDE_O_VYJIMKU_SLOVA(ident_tvaru) == 0) {
            if (SKLONUJ_SLOVESA(vzor,osoba,cislo,4,1,1,0,0,0,"","") == 0) continue;
           }
          ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
         }
       }

                                                          //infinitiv
      ident_tvaru[0]=0;
      VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cas_,5);
      VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_vid_,vid);
      VYTVOR_IDENTIFIKACI_TVARU_SLOVA(vzor,id_slova,ident_tvaru);

      if (ZJISTI_ZDA_JDE_O_VYJIMKU_SLOVA(ident_tvaru) == 0) {
        if (SKLONUJ_SLOVESA(vzor,1,1,5,1,1,0,0,0,"","") == 0) goto KONECCYKLU52;
       }
      ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();

      KONECCYKLU52:


      strcpy(puvslovozaklad,g_slovozaklad);

      ZAPIS_DO_UPLNEHO_SLOVNIKU_SLOVO(1);         //vynulovani "nejnizsich" pozic
      ZAPIS_VNOROVANI('1');
      for (pozice=1; ; pozice++) {                        //"dělání"
        strcpy(g_slovozaklad,puvslovozaklad);
        if (ZJISTI_ZDA_JDE_O_VYJIMKU_SLOVA("") == 0) {
          vzorslova=SKLONUJ_SLOVESA(vzor,1,1,1,1,1,0,0,1,"","1");
         }
        else vzorslova=ROZPOZNEJ_VZOR_PODSTATNEHO_JMENA_PODLE_KONCOVKY(g_slovavefronte,255,0);
        if (vzorslova == 0) break;
        if (OREZ_FRONTU_NA_1_SLOVO(pozice) == 0) break;
        strcpy(g_slovozaklad,g_slovavefronte);
        ROZSKLONUJ_PODLE_SPRAVNEHO_VZORU(vzorslova,id_slova,1,vid,1);
       }
      ZAPIS_VNOROVANI(0);

      ZAPIS_DO_UPLNEHO_SLOVNIKU_SLOVO(1);         //vynulovani "nejnizsich" pozic
      ZAPIS_VNOROVANI('3');
      for (pozice=1; ; pozice++) {                    //"dělající"
        strcpy(g_slovozaklad,puvslovozaklad);
        if (ZJISTI_ZDA_JDE_O_VYJIMKU_SLOVA("") == 0) {
          if (SKLONUJ_SLOVESA(vzor,1,1,1,1,1,0,0,3,"","3") == 0) break;
         }
        if (OREZ_FRONTU_NA_1_SLOVO(pozice) == 0) break;
        strcpy(g_slovozaklad,g_slovavefronte);
        ROZSKLONUJ_PODLE_SPRAVNEHO_VZORU(_jarni_,id_slova,0,vid,1);
  //je zde neuplne rozsklonovani, protoze nelze stupnovat a delat prislovce
       }
      ZAPIS_VNOROVANI(0);


      ZAPIS_VNOROVANI('c');
      for (pozice=1; ; pozice++) {                  //"holicí"
        if (vzor < _prosi_ || vzor > _sazi_) break;  //pouze prosí, trpí, sází
        strcpy(g_slovozaklad,puvslovozaklad);
        if (ZJISTI_ZDA_JDE_O_VYJIMKU_SLOVA("") == 0) {
          if (SKLONUJ_SLOVESA(vzor,1,1,1,1,1,0,0,30,"","c") == 0) break;
         }
        if (OREZ_FRONTU_NA_1_SLOVO(pozice) == 0) break;
        strcpy(g_slovozaklad,g_slovavefronte);
        ROZSKLONUJ_PODLE_SPRAVNEHO_VZORU(_jarni_,id_slova,0,vid,1);
  //je zde neuplne rozsklonovani, protoze nelze stupnovat a delat prislovce
       }
      ZAPIS_VNOROVANI(0);


      ZAPIS_VNOROVANI('4');
      ZAPIS_DO_UPLNEHO_SLOVNIKU_SLOVO(1);         //vynulovani "nejnizsich" pozic
      for (pozice=1; ; pozice++) {                   //"dělaný"
        strcpy(g_slovozaklad,puvslovozaklad);
        if (ZJISTI_ZDA_JDE_O_VYJIMKU_SLOVA("") == 0) {
          if (SKLONUJ_SLOVESA(vzor,1,1,1,1,1,0,0,4,"","4") == 0) break;
         }
        if (OREZ_FRONTU_NA_1_SLOVO(pozice) == 0) break;
        strcpy(g_slovozaklad,g_slovavefronte);
        ROZSKLONUJ_PODLE_SPRAVNEHO_VZORU(_mlady_,id_slova,1,vid,1);
       }
      ZAPIS_VNOROVANI(0);

      ZAPIS_DO_UPLNEHO_SLOVNIKU_SLOVO(1);         //vynulovani "nejnizsich" pozic
      if (vid == 1) {      //na nedokonavý vid se převádí jen dokonavý vid
        ZAPIS_VNOROVANI('5');
        for (pozice=1; ; pozice++) {                    //nedokonavý vid
          strcpy(g_slovozaklad,puvslovozaklad);
          if (ZJISTI_ZDA_JDE_O_VYJIMKU_SLOVA("") == 0) {
            vzorslova=SKLONUJ_SLOVESA(vzor,3,1,2,1,0,0,0,5,"","5");
           }
          else vzorslova=ROZPOZNEJ_VZOR_SLOVESA_PODLE_KONCOVKY(g_slovavefronte);
          if (vzorslova == 0) break;
          if (OREZ_FRONTU_NA_1_SLOVO(pozice) == 0) break;
          strcpy(g_slovozaklad,g_slovavefronte);
          ROZSKLONUJ_PODLE_SPRAVNEHO_VZORU(vzorslova,id_slova,1,0,1);
         }
        ZAPIS_VNOROVANI(0);
       }
      else if (rekurze == 0) {  //vytvori se jen nesamostatna slova (bere - bírá atd.)
        ZAPIS_VNOROVANI('E');
        for (pozice=1; ; pozice++) {                    //nedokonavý vid
          strcpy(g_slovozaklad,puvslovozaklad);
          if (ZJISTI_ZDA_JDE_O_VYJIMKU_SLOVA("") == 0) {
            vzorslova=SKLONUJ_SLOVESA(vzor,3,1,2,1,0,0,0,5,"","5"); //pozor! ne 'E', ale 5 (kvuli jednoduchosti)
           }
          else vzorslova=ROZPOZNEJ_VZOR_SLOVESA_PODLE_KONCOVKY(g_slovavefronte);
          if (vzorslova == 0) break;
          if (OREZ_FRONTU_NA_1_SLOVO(pozice) == 0) break;
          strcpy(g_slovozaklad,g_slovavefronte);
          ROZSKLONUJ_PODLE_SPRAVNEHO_VZORU(vzorslova,id_slova,1,0,1);
         }
        ZAPIS_VNOROVANI(0);
       }
      break;
    case 12:                                //sloveso "je"
      for (rod=1; rod <= 3; rod++) {                 //minuly cas
        for (cislo=1; cislo <= 2; cislo++) {
          for (zivotnost=0; zivotnost <= 1; zivotnost++) {

            ident_tvaru[0]=0;
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cislo_,cislo);
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cas_,1);
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_rod_,rod);
            if (cislo == 2 && rod == 1) {
              VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_zivotnost_,zivotnost);
             }
            VYTVOR_IDENTIFIKACI_TVARU_SLOVA(_je_,0,ident_tvaru);

            if (SKLONUJ_SLOVESA(_je_,1,cislo,1,rod,0,zivotnost,0,0,"","") == 1)
             ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();

            if (cislo == 2 && rod == 1);
            else break;          //zivotnost je pouze v 1 pripade
           }
         }
       }

      for (cas=2; cas <= 3; cas++) {
        for (cislo=1; cislo <= 2; cislo++) {
          for (osoba=1; osoba <= 3; osoba++) {

            ident_tvaru[0]=0;
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_osoba_,osoba);
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cislo_,cislo);
            VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cas_,cas);
            VYTVOR_IDENTIFIKACI_TVARU_SLOVA(_je_,0,ident_tvaru);

            if (SKLONUJ_SLOVESA(vzor,osoba,cislo,cas,1,0,0,0,0,"","") == 1)
             ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
       }
         }
       }

      for (cislo=1; cislo <= 2; cislo++) {                    //rozkaz
        for (osoba=1; osoba <= 2; osoba++) {
          if (osoba == 1 && cislo == 1) continue;        //neexistuje tvar

          ident_tvaru[0]=0;
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_osoba_,osoba);
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cislo_,cislo);
          VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cas_,4);
          VYTVOR_IDENTIFIKACI_TVARU_SLOVA(vzor,id_slova,ident_tvaru);

          if (SKLONUJ_SLOVESA(_je_,osoba,cislo,4,1,1,0,0,0,"","") == 0) continue;
          ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
         }
       }

                                                          //infinitiv
      ident_tvaru[0]=0;
      VRAT_BAJT_DO_IDENTIFIKACE_TVARU(ident_tvaru,_cas_,5);
      VYTVOR_IDENTIFIKACI_TVARU_SLOVA(vzor,id_slova,ident_tvaru);

      if (SKLONUJ_SLOVESA(vzor,1,1,5,1,1,0,0,0,"","") == 1) 
       ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();


      strcpy(puvslovozaklad,g_slovozaklad);

      for (pozice=1; ; pozice++) {                        //"bytí"
        strcpy(g_slovozaklad,puvslovozaklad);
        if (SKLONUJ_SLOVESA(_je_,1,1,1,1,1,0,0,1,"","") == 0) break;
        if (OREZ_FRONTU_NA_1_SLOVO(pozice) == 0) break;
        strcpy(g_slovozaklad,g_slovavefronte);
        ZAPIS_VNOROVANI('1');
        ROZSKLONUJ_PODLE_SPRAVNEHO_VZORU(_staveni_,id_slova,1,vid,1);
        ZAPIS_VNOROVANI(0);
       }

      for (pozice=1; ; pozice++) {                        //"bývá"
        strcpy(g_slovozaklad,puvslovozaklad);
        if ((vzor=SKLONUJ_SLOVESA(_je_,1,1,1,1,1,0,0,6,"","")) == 0) break;
        if (OREZ_FRONTU_NA_1_SLOVO(pozice) == 0) break;
        strcpy(g_slovozaklad,g_slovavefronte);
        ZAPIS_VNOROVANI('6');
        ROZSKLONUJ_PODLE_SPRAVNEHO_VZORU(vzor,id_slova,1,vid,1);
        ZAPIS_VNOROVANI(0);
       }
      break;
    case 6:                                   //nesklonna prislovce
    case 7:                                   //predlozky
    case 8:                                   //spojky
    case 9:                                   //castice
    case 10:                                  //citoslovce
      VYTVOR_IDENTIFIKACI_TVARU_SLOVA(vzor,id_slova,"");
      strcpy(g_slovavefronte,g_slovozaklad);
      ZAPIS_DO_UPLNEHO_SLOVNIKU_FRONTU();
      break;
   }
  UVOLNI(puvslovozaklad); UVOLNI(ident_tvaru);
 }

void NACTI_A_ROZSKLONUJ_ZAKLADNI_SLOVNIK(void) {
WORD poziceslova;

#if IQPOKYDWINMFC != 1        //uz to je nactene
  VYNULUJ_HODNOTY_K_ROZSKLONOVANI();
  PRECTI_DATABAZI_SLOV_ZE_ZAKLADNIHO_SLOVNIKU();
#endif

  debug_maxpocetvsechslov=0;
  g_docasnadatabazeuplnychslov=ALOKUJ_POINTERY(MAX_POCET_VSECH_SLOV*sizeof(char *));

  ZAPIS_DO_UPLNEHO_SLOVNIKU_SLOVO(1);    //vynulovani "nejnizsich" promennych


#if IQPOKYDWINMFC == 1
  g_praveprovadenaakce=2; g_procentanacitani=0; //nacitani uplneho slovniku
  g_handletext1->SetWindowText("Skloňuji slovník...");
#else
  NAPIS_TEXT_V_LATIN_2("\rSkloňuji...\n");
#endif

  ZAPIS_VNOROVANI('C');
  ROZSKLONUJ_PODLE_SPRAVNEHO_VZORU(_je_,0,1,0,0);     //sloveso "je"
  ZAPIS_VNOROVANI(0);
  ZAPIS_DO_UPLNEHO_SLOVNIKU_SLOVO(1);    //vynulovani "nejnizsich" promennych

#if IQPOKYDWINMFC == 1
  g_procentanacitani=3/10;
#endif

  ZAPIS_VNOROVANI('3');
  ROZSKLONUJ_PODLE_SPRAVNEHO_VZORU(40,0,1,0,0);     //zajmena
  ZAPIS_VNOROVANI(0);
  ZAPIS_DO_UPLNEHO_SLOVNIKU_SLOVO(1);    //vynulovani "nejnizsich" promennych

#if IQPOKYDWINMFC == 1
  g_procentanacitani=1;
#endif

/*//!
  ZAPIS_VNOROVANI('4');
  ROZSKLONUJ_PODLE_SPRAVNEHO_VZORU(50,0,1,0,0);     //cislovky
  ZAPIS_VNOROVANI(0);
  ZAPIS_DO_UPLNEHO_SLOVNIKU_SLOVO(1);    //vynulovani "nejnizsich" promennych
*/

#if IQPOKYDWINMFC == 1
  g_procentanacitani=1;
#else
  printf("\r0.0%%");
#endif
  for (poziceslova=1; poziceslova <= g_pocetslovvzakladnidatabazi; poziceslova++) {
    VRAT_SLOVO_ZE_ZAKLADNIHO_SLOVNIKU(poziceslova);

/*    if (strlen(g_slovozaklad) > 5) {

      g_slovozaklad[0]='a'+rand()%('z'-'a');
      g_slovozaklad[2]='a'+rand()%('z'-'a');
    POKUS:
      g_slovozaklad[rand()%(strlen(g_slovozaklad)-3)]='a'+rand()%('z'-'a');
      if ((rand()%10) != 0) goto POKUS;
     }
*/
    sprintf(g_vnoreniprirozsklonovani,"%c",VRAT_SLOVNI_DRUH(g_informaceoslove[0]) == 10 ? '0' : VRAT_SLOVNI_DRUH(g_informaceoslove[0])+'0');

    ROZSKLONUJ_PODLE_SPRAVNEHO_VZORU(g_informaceoslove[0],poziceslova,1,VRAT_SLOVNI_DRUH(g_informaceoslove[0]) == 5 ? g_informaceoslove[1]-1 : 255,0);
                                                 //zapamatovani si nejnizsiho
    if (g_vnoreniprirozsklonovani[1] != 0) {
      NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_); // printf("Chyba!!! Zbylo g_vnoreniprirozsklonovani!");
     }

    ZAPIS_DO_UPLNEHO_SLOVNIKU_SLOVO(1);    //vynulovani "nejnizsi" promenne
#if IQPOKYDWINMFC == 1
    g_procentanacitani=(long double)(poziceslova)*99/(long double)g_pocetslovvzakladnidatabazi+1;
    if (g_zavritvlaknoprocesu == 1)
     return;
#else
    if ((poziceslova%10) == 0)
     printf("\r%.1Lf%%",(long double)((long double)(poziceslova)*100/(long double)g_pocetslovvzakladnidatabazi));
#endif        

   }                           //rozsklonovani slov - 1. narocna operace

#if IQPOKYDWINMFC == 1
  g_praveprovadenaakce=3; g_procentanacitani=0; //nacitani uplneho slovniku
  g_handletext1->SetWindowText("Třídím slovní zásobu...");
#else
  NAPIS_TEXT_V_LATIN_2("\rTřídím...\n");
#endif
  SETRID_SLOVA_V_DATABAZI();
        //setrideni slov v celem slovniku - 2. narocna operace


#if IQPOKYDWINMFC == 1
  if (g_zavritvlaknoprocesu == 1) return;
  g_praveprovadenaakce=4; g_procentanacitani=0; //zapisovani slovniku
  g_handletext1->SetWindowText("Zapisuji slovník...");
#else
  printf("\rZapisuji...\n");
#endif
  ZAPIS_DATABAZI_SLOV_DO_UPLNEHO_SLOVNIKU();

#if IQPOKYDWINMFC != 1
  if (g_zavritvlaknoprocesu == 1) return;
  printf("\rHotovo. Prevedeno %lu slov.\nMAX_POCET_VSECH_SLOV: %lu\n\n",g_pocetslovvzakladnidatabazi,debug_maxpocetvsechslov);
  ALOKUJ_VSECHNY_PRVKY_G_VETACLOVEKA();  //aby se melo co uvolnit :-)
  UVOLNI_VESKEROU_DYNAMICKOU_PAMET();    //...tady
  printf("\rStiskni cokoliv\n");

  if (debug_pocetalokovani > 0) NAHLAS_CHYBU("Chyba programu!\r\n\r\nNebyly uvolněny všechny paměťové bloky!\r\n\r\n(Kontaktujte prosím autora programu.)",0,_JINA_CHYBA_,_UKONCIT_);

  if (debug_pocetalokovani == 0) NAPIS_TEXT_V_LATIN_2("Pamět úspěšně uvolněna.\n");

  getch();
#endif
 }
