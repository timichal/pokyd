                       "Najdeš ho na adrese \"http://iqpokyd.kyblsoft.cz\".");
     }
   }
  else if (typchyby == _CHYBA_ZAPISU_) {
    strcpy(textchyby,""
           "Chyba: na disk, odkud je spouštìn IQ Pokyd, nelze zapisovat."
           "\n\nCo s tím: Nejspíš to bude tím, e mì spouštíš napø. z cédéèka nebo jiného "
           "nepøepisovatelného disku. Staèí tedy celı adresáø s IQ Pokydem nakopírovat "
