   }
  else if (typchyby == _MALO_PAMETI_) {
    strcpy(textchyby,""
           "Chyba: program IQ Pokyd má ke svému bìhu málo volné pamìti."
           "\n\nCo s tím: Nìjakou pamì uvolni. Jak? Zavøi všechny ostatní programy "
           "nebo zvìtši velikost stránkovací (virtuální) pamìti."
           "\nPøípadnì je také moné, e virtuální pamìti je teoreticky dost, "
