                       "\n\nGenerování bude nìjakou chvíli trvat.");
     }
    else {
      if (typchyby == _SPATNY_ZAKLADNI_SLOVNIK_)
       strcpy(textchyby,"Chyba: Soubor "JMENO_ZAKLADNIHO_SLOVNIKU" je narušen.");
      else
       strcpy(textchyby,"Chyba: Soubor "JMENO_SOUBORU_S_INTELIGENCI" je narušen.");

      strcat(textchyby," Chyba nejspíš nastala pøi kopírování programu."
                       " Tento soubor však nutnì potøebuji ke svému chodu."
                       "\n\nCo s tím: Øešením je zkopírovat tento soubor znova. Pokud u nemáš "
