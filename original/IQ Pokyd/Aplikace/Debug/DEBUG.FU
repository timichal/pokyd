 }

void ZKONTROLUJ_SPRAVNOST_UPLNEHO_SLOVNIKU(void) {
DWORD pozice,celkem;
WORD malapozice1,malapozice2;
char *informace;
Typ_slova trida;

  printf("\r0%%      ");
  informace=ALOKUJ_RETEZEC(DELKA_NALEZENYCH_INFORMACI);
  for (g_aktualnipismeno=0; g_aktualnipismeno < POCET_DVOJPISMEN; g_aktualnipismeno++) {
    for (pozice=0,celkem=g_pocetslovvuplnedatabazi[g_aktualnipismeno]; pozice < celkem; pozice++) {
      for (malapozice1=0; g_databazeuplnychslov[g_aktualnipismeno][pozice][malapozice1] != ZAKODOVANY_ZNAK(':'); malapozice1++) {
        if (malapozice1 >= DELKA_JEDNODUCHEHO_SLOVA) {
          NAHLAS_CHYBU("Pøíliš dlouhé slovo ve \"velkém\" slovníku.",0,_JINA_CHYBA_,_STORNO_);
         }
       }
      malapozice1++;
      for (malapozice2=0; g_databazeuplnychslov[g_aktualnipismeno][pozice][malapozice1] != 0; malapozice1++,malapozice2++) {
        if (malapozice2 >= DELKA_NALEZENYCH_INFORMACI) {
          NAHLAS_CHYBU("Pøíliš dlouhé informace o slovì v \"velkém\" slovníku.",0,_JINA_CHYBA_,_STORNO_);
         }
        informace[malapozice2]=g_databazeuplnychslov[g_aktualnipismeno][pozice][malapozice1];
       }
      informace[malapozice2]=0;
      DEKODUJ_SLOVO_V_PAMETI(informace);
      trida=PREVED_NA_TRIDU_TYP_SLOVA(informace,0,"",1);
      trida.VYMAZ_OBSAH();
     }
    printf("\r%u%%",(g_aktualnipismeno+1)*100/POCET_DVOJPISMEN);
   }
  UVOLNI(informace);
 }
