BYTE JELI_ZNELA_SOUHLASKA(char znak) {
  switch(znak) {
    case 'r': case 'l': case 'm': case 'n': case 'ò':   //toto je typ "sonor"
    case 'b': case 'd': case 'ï': case 'g': case 'v':
    case 'z': case 'ž': case 'h': return(1);
    default: return(0);
   }
 }

char *HLEDEJ_SLOVO_S_PREDPONOU(char *slovo,char *predpona,char *predpona_s_e,char *nespisovnapredpona,BYTE atributy) {
   //funkce vraci pouzitou predponu a informace v promenne "informaceoslove"
   //pri nenalezeni vraci NULL
int delkapredpony=strlen(predpona),delkapredpony_s_e=strlen(predpona_s_e),delkanespisovnepredpony=strlen(nespisovnapredpona),testkonce;
char *navrat=NULL;
  testkonce=0;
  if (strncmp(slovo,predpona,delkapredpony) == 0) {
    if (predpona_s_e[0] != 0 && strncmp(slovo,predpona_s_e,delkapredpony_s_e) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo+delkapredpony_s_e,0,atributy+4,0);
      if (g_nalezeneinformaceoslove[0] != 0) { navrat=predpona_s_e; testkonce=strlen(g_nalezeneinformaceoslove); }
     }
    VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo+delkapredpony,0,atributy+4,0);
    if (g_nalezeneinformaceoslove[testkonce] != 0) navrat=predpona;
   }
  else if (nespisovnapredpona[0] != 0 && strncmp(slovo,nespisovnapredpona,delkanespisovnepredpony) == 0) {
    VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo+delkanespisovnepredpony,0,atributy+4,0);
    if (g_nalezeneinformaceoslove[0] != 0) navrat=predpona;
   }
  return(navrat);
 }

Typ_slova KOMPLETNE_VRAT_INFORMACE_O_SLOVU_Z_UPLNEHO_SLOVNIKU(char *hledaneslovo,BYTE atributy) {
                     //toto je funkce pro bezne pouziti
                     //hleda slovo i s toleranci, i vcetne predpon
                     //"atributy" jsou spise z rekurzivnich duvodu, standardne 0
Typ_slova navrat,novynavrat;
WORD pozice;
char *predpona=NULL;

  if (strcmp(hledaneslovo,"neòí") == 0 || strcmp(hledaneslovo,"neòi") == 0) {
    //u slova "není" je výjimka jako prase - je to totiž nestandardní
    // zápor slova "je". Takže se najde "je" a zápor se potom pøidá

    VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU("je",0,atributy,0);
                               //napred se zkusi najit slovo i vcetne pripony
    OREZ_FRONTU_NA_1_SLOVO(g_nalezeneinformaceoslove,1);
    navrat=PREVED_NA_TRIDU_TYP_SLOVA(g_nalezeneinformaceoslove,0,"",1);
    navrat.zapor[0]=1;
  
    return(navrat);

   }
  else {                //všechna ostatní normální slova

    VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(hledaneslovo,0,atributy,0);
                                 //napred se zkusi najit slovo i vcetne pripony
    navrat=PREVED_NA_TRIDU_TYP_SLOVA(g_nalezeneinformaceoslove,0,"",1);
    g_nalezeneinformaceoslove[0]=0;

   }

  if (atributy == 0 && strncmp(hledaneslovo,"nej",3) == 0) {
    novynavrat=KOMPLETNE_VRAT_INFORMACE_O_SLOVU_Z_UPLNEHO_SLOVNIKU(hledaneslovo+3,1);
    for (pozice=0; pozice < novynavrat.pocetslov; pozice++) {
      switch(novynavrat.tvar[pozice]) {   //pøidání údaje o 3. stupni
        case 0: novynavrat.tvar[pozice]=5; break;  //normální tøetí stupeò
        case 1: novynavrat.tvar[pozice]=6; break;  //tøetí stupeò tvaru pøíslovce
       }
     }
    navrat.PRIPOJ(novynavrat);
    novynavrat.VYMAZ_OBSAH(); g_nalezeneinformaceoslove[0]=0;
   }
  if ((atributy&2) == 0 && strncmp(hledaneslovo,"ne",2) == 0) {
    novynavrat=KOMPLETNE_VRAT_INFORMACE_O_SLOVU_Z_UPLNEHO_SLOVNIKU(hledaneslovo+2,atributy+2);
    for (pozice=0; pozice < novynavrat.pocetslov; pozice++) {
      novynavrat.zapor[pozice]=1;
     }
    navrat.PRIPOJ(novynavrat);
    novynavrat.VYMAZ_OBSAH(); g_nalezeneinformaceoslove[0]=0;
   }

  for (pozice=1; pozice <= 20; pozice++) {
    switch(pozice) {
      case 1: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"do","","",atributy); break;
      case 2: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"na","","",atributy); break;
      case 3: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"nad","nade","nat",atributy); break;
      case 4: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"o","","",atributy); break;
      case 5: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"ob","obe","op",atributy); break;
      case 6: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"od","ode","ot",atributy); break;
      case 7: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"po","","",atributy); break;
      case 8: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"pod","pode","pot",atributy); break;
      case 9: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"pro","","",atributy); break;
      case 10: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"pøe","","",atributy); break;
      case 11: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"pøed","pøede","pøet",atributy); break;
      case 12: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"pøi","","",atributy); break;
      case 13: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"roz","roze","ros",atributy); break;
      case 14: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"s","se","",atributy); break;
      case 15: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"u","","",atributy); break;
      case 16: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"v","ve","",atributy); break;
      case 17: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"vy","","vi",atributy); break;
      case 18: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"vz","vze","vs",atributy); break;
      case 19: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"z","ze","",atributy); break;
      case 20: predpona=HLEDEJ_SLOVO_S_PREDPONOU(hledaneslovo,"za","","",atributy); break;
     }
                         //zpracovani pripadnych dalsich slov s predponami
    if (g_nalezeneinformaceoslove[0] != 0 && predpona != NULL) { //tady kdyz neni jedno, neni ani druhy
      novynavrat=PREVED_NA_TRIDU_TYP_SLOVA(g_nalezeneinformaceoslove,0,predpona,1);
      navrat.PRIPOJ(novynavrat);
      novynavrat.VYMAZ_OBSAH();
      g_nalezeneinformaceoslove[0]=0;
     }
   }

                                   //doplneni chybejiciho atributu "zapor"
  for (pozice=0; pozice < navrat.pocetslov; pozice++) {
    if (navrat.zapor[pozice] == 255) navrat.zapor[pozice]=0;
   }

  return(navrat);
 }

void VRAT_INFORMACE_O_SLOVU_Z_UPLNEHO_SLOVNIKU(char *hledaneslovo,BYTE atributy) {
signed long minimum,maximum,pozice;
char *zakodovaneslovo=NULL,*nalezeneinfo=NULL;

          //zapise nalezene informace do g_nalezeneinformaceoslove (najde-li)

          //princip hledani: Slovo se porovna s prostrednim slovem, tim se
          //vylouci polovina, pak dalsi polovina atd., az se dojde k hledanemu
          //slovu (a nebo taky ne :-) )

  VRAT_HODNOTU_PROMENNE_AKTUALNIPISMENO(hledaneslovo);
  zakodovaneslovo=ALOKUJ_RETEZEC(strlen(hledaneslovo)+2);
  strcpy(zakodovaneslovo,hledaneslovo);
  strcat(zakodovaneslovo,":"); //aby byly hodnoty stejne jako pri rozsklonovani
  ZAKODUJ_SLOVO_V_PAMETI(zakodovaneslovo);

  for (minimum=0,maximum=g_pocetslovvuplnedatabazi[g_aktualnipismeno]-1;
       minimum <= maximum; ) {
    pozice=(minimum+maximum)/2;
    switch(POROVNEJ_DVE_SLOVA(g_databazeuplnychslov[g_aktualnipismeno][pozice],zakodovaneslovo)) {
      case -1: minimum=pozice+1; goto NOVEHLEDANI;
      case  1: maximum=pozice-1; goto NOVEHLEDANI;
      case  0: nalezeneinfo=ALOKUJ_RETEZEC(strlen(g_databazeuplnychslov[g_aktualnipismeno][pozice])+1);
               strcpy(nalezeneinfo,g_databazeuplnychslov[g_aktualnipismeno][pozice]+strlen(zakodovaneslovo));
                     //nalezeno (pointer poposunuty o delku slova (vcetne dvojtecky))
               DEKODUJ_SLOVO_V_PAMETI(nalezeneinfo);
               PROCISTI_SLOVA_PODLE_ATRIBUTU(nalezeneinfo,atributy);
               PRIDEJ_DO_PRECHODNE_FRONTY(g_nalezeneinformaceoslove,nalezeneinfo);
               UVOLNI(nalezeneinfo);
               goto KONEC;
     }
    NOVEHLEDANI:;
   }

                          //nenalezeno

  KONEC:
  UVOLNI(zakodovaneslovo);
 }

void VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(char *slovo,int pozice,BYTE atributy,BYTE pocetrekurzi) {
         //Tato funkce rekurzivne zjisti vsechny mozne pravopisne chyby a
         //informace o slove ve vsech nespisovnych tvarech vrati do
         //g_nalezeneinformaceoslove.
         //"pozice" je z duvodu rekurzivnich, na zacatku se vzdy dava 0.

int celkem=strlen(slovo);
char *pointer=NULL,*utvoreneslovo=NULL;

  if (slovo[0] == 0) return;            //prazdne slovo

// následující pøípad nijak nesouvisí s kontrolou pravopisu. Musí se ovšem
// zjistit obì možnosti typu [statyv] nebo [stái se]

  if (pocetrekurzi >= g_nastaveni.debug_pravopisnarekurze) {
                                         //pocet rekurzi za limitem
    pozice=celkem; pointer=slovo+celkem; goto ZA_KONTROLAMI;
   }

  for (pointer=slovo+pozice; pozice < celkem; pozice++,pointer=slovo+pozice) {
  
    if ((pointer[0] == 'ï' || pointer[0] == '' || pointer[0] == 'ò')
     && pointer[1] == 'i') {      //'di'=>'Di', 'ti'=>'Ti', 'ni'=>'Ni'
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);

      utvoreneslovo=ALOKUJ_RETEZEC(celkem+2);
      strcpy(utvoreneslovo,slovo);
      switch(slovo[pozice]) {
        case 'ï': utvoreneslovo[pozice]='D'; break;
        case '': utvoreneslovo[pozice]='T'; break;
        case 'ò': utvoreneslovo[pozice]='N'; break;
       }
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+2,atributy,pocetrekurzi+1);

      UVOLNI(utvoreneslovo);
      return;
     }

    if (g_nastaveni.debug_tolerancepravopisu == 0) continue;
        //Pokud se nekontroluje pravopis, uz se nepokracuje v podminkach

    if (pointer[0] == 'i') {                       // 'i' => 'y'
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
                                             //prvni hledani neupraveneho slova
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      if (pozice > 0) {               //pokud 'i' neni prvni pismeno ve slovu
        switch(pointer[-1]) {
          case 'ï': utvoreneslovo[pozice]='d'; break;
          case '': utvoreneslovo[pozice]='t'; break;
          case 'ò': utvoreneslovo[pozice]='n'; break;
         }
       }
      pointer[0]='y';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
                                             //druhe hledani upraveneho slova
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'y') {                       // 'y' => 'i'
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      if (pozice > 0) {               //pokud 'y' neni prvni pismeno ve slovu
        if (pointer[-1] == 'd') pointer[-1]='D';
        else if (pointer[-1] == 't') pointer[-1]='T';
        else if (pointer[-1] == 'n') pointer[-1]='N';
       }
      pointer[0]='i';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'í') {                       // 'í' => 'ý'
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      if (pozice > 0) {            //pokud 'í' neni prvni pismeno ve slovu
        if (pointer[-1] == 'ï') pointer[-1]='d';
        else if (pointer[-1] == '') pointer[-1]='t';
        else if (pointer[-1] == 'ò') goto UVOLNIPAMET1;  //po "n" by snad nikdo mekke dlouhe i nenapsal
       }
      pointer[0]='ý';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNIPAMET1:
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'ý') {                       // 'ý' => 'í'
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      if (pozice > 0) {               //pokud 'ý' neni prvni pismeno ve slovu
        if (pointer[-1] == 'd') pointer[-1]='D';
        else if (pointer[-1] == 't') pointer[-1]='T';
        else if (pointer[-1] == 'n') pointer[-1]='N';
       }
      pointer[0]='í';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if ((pointer[0] == 'B' || pointer[0] == 'F' || pointer[0] == 'M' || pointer[0] == 'V')
     && pointer[1] == 'e') {  //'bì'=>'bje','fì'=>'fje','vì'=>'vje','mì'=>'mnì'
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+2,atributy,pocetrekurzi+1);

      utvoreneslovo=ALOKUJ_RETEZEC(celkem+2);
      strncpy(utvoreneslovo,slovo,pozice);
      utvoreneslovo[pozice]=slovo[pozice]+32;
      strcpy(utvoreneslovo+pozice+1,pointer[0] == 'M' ? "òe" : "je");
      strcpy(utvoreneslovo+pozice+3,slovo+pozice+2);
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+3,atributy,pocetrekurzi+1);

      UVOLNI(utvoreneslovo);
      return;
     }

    if (((pointer[0] == 'b' || pointer[0] == 'f' || pointer[0] == 'p' || pointer[0] == 'v')
      && pointer[1] == 'j' && pointer[2] == 'e')
      || (pointer[0] == 'm' && pointer[1] == 'ò' && pointer[2] == 'e')) {
                //'bje'=>'bì','fje'=>'fì','pje'=>'pì','vje'=>'vì','mnì'=>'mì'
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+3,atributy,pocetrekurzi+1);

      utvoreneslovo=ALOKUJ_RETEZEC(celkem);
      strncpy(utvoreneslovo,slovo,pozice);
      utvoreneslovo[pozice]=slovo[pozice]-32; utvoreneslovo[pozice+1]='e';
      strcpy(utvoreneslovo+pozice+2,pointer+3);
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
                                             //druhe hledani upraveneho slova
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'b'                         // 'b' => 'p'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='p';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'p'                         // 'p' => 'b'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='b';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'd'                         // 'd' => 't'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='t';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 't'                         // 't' => 'd'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='d';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'ï'                         // 'ï' => ''
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == ''                         // '' => 'ï'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='ï';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'f'                         // 'f' => 'v'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='v';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'v'                         // 'v' => 'f'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='f';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'g'                         // 'g' => 'k'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='k';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'k'                         // 'k' => 'g'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && (JELI_ZNELA_SOUHLASKA(pointer[1]) == 0 || pointer[1] == 'd')) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='g';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'h'                         // 'h' => 'ch'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && (JELI_ZNELA_SOUHLASKA(pointer[1]) == 0 || pointer[1] == 'd')) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='*';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == '*'                         // 'ch' => 'h'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='h';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 's'                         // 's' => 'z'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='z';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'z'                         // 'z' => 's'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='s';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'š'                         // 'š' => 'ž'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='ž';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'ž'                         // 'ž' => 'š'
     && JELI_SAMOHLASKA(pointer[1]) == 0 && JELI_ZNELA_SOUHLASKA(pointer[1]) == 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='š';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'ú'                         // 'ú' => 'ù'
     && pozice > 0) {                 //pokud to neni na zacatku slova
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='ù';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'ù') {                      // 'ú' => 'ù'
      if (pozice > 0) {                 //pokud to neni na zacatku slova
        VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);
       }                                //...jinak je zmena vzdycky
      utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
      strcpy(utvoreneslovo,slovo); pointer=utvoreneslovo+pozice;
      pointer[0]='ú';
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+1,atributy,pocetrekurzi+1);
      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'š'                         // 'š' => 'zš', 'š' => 'šš'
     && JELI_SAMOHLASKA(pointer[1]) == 1 && pozice > 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);

      utvoreneslovo=ALOKUJ_RETEZEC(celkem+2);
      strncpy(utvoreneslovo,slovo,pozice);
      utvoreneslovo[pozice]='z';                     //napø. snazší
      strcpy(utvoreneslovo+pozice+1,slovo+pozice);
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+2,atributy,pocetrekurzi+1);

      utvoreneslovo[pozice]='š';                     //napø. jednodušší
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+2,atributy,pocetrekurzi+1);

      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'n'                         // 'n' => 'nn'
     && JELI_SAMOHLASKA(pointer[1]) == 1 && pozice > 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);

      utvoreneslovo=ALOKUJ_RETEZEC(celkem+2);
      strncpy(utvoreneslovo,slovo,pozice);
      utvoreneslovo[pozice]='n';
      strcpy(utvoreneslovo+pozice+1,slovo+pozice);
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+2,atributy,pocetrekurzi+1);

      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'ò'                         // 'ò' => 'nò'
     && JELI_SAMOHLASKA(pointer[1]) == 1 && pozice > 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);

      utvoreneslovo=ALOKUJ_RETEZEC(celkem+2);
      strncpy(utvoreneslovo,slovo,pozice);
      utvoreneslovo[pozice]='n';
      strcpy(utvoreneslovo+pozice+1,slovo+pozice);
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+2,atributy,pocetrekurzi+1);

      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'n' && pointer[1] == 'n'           // 'nn' => 'n'
     && JELI_SAMOHLASKA(pointer[2]) == 1) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);

      utvoreneslovo=ALOKUJ_RETEZEC(celkem);
      strncpy(utvoreneslovo,slovo,pozice);
      strcpy(utvoreneslovo+pozice,slovo+pozice+1);
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+2,atributy,pocetrekurzi+1);

      UVOLNI(utvoreneslovo);
      return;
     }

    if (pointer[0] == 'n' && pointer[1] == 'ò'           // 'nò' => 'ò'
     && JELI_SAMOHLASKA(pointer[2]) == 1 && pozice > 0) {
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(slovo,pozice+1,atributy,pocetrekurzi+1);

      utvoreneslovo=ALOKUJ_RETEZEC(celkem);
      strncpy(utvoreneslovo,slovo,pozice);
      strcpy(utvoreneslovo+pozice,slovo+pozice+1);
      VRAT_INFORMACE_O_SLOVU_S_TOLERANCI_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,pozice+2,atributy,pocetrekurzi+1);

      UVOLNI(utvoreneslovo);
      return;
     }
                         //zadna mozna zmena, jde se na dalsi pismeno
   }

  ZA_KONTROLAMI:

  if (pointer[-2] == 'a' && pointer[-1] == 't') {
//pokud slovo konèí na "at", mùže to být i "át" (napø. nabrat - brát)
    VRAT_INFORMACE_O_SLOVU_Z_UPLNEHO_SLOVNIKU(slovo,atributy);
     
    utvoreneslovo=ALOKUJ_RETEZEC(celkem+1);
    strcpy(utvoreneslovo,slovo);
    utvoreneslovo[celkem-2]='á';
    VRAT_INFORMACE_O_SLOVU_Z_UPLNEHO_SLOVNIKU(utvoreneslovo,atributy+8);
    UVOLNI(utvoreneslovo);
   }
  else         //ve všech ostatních pøípadech
   VRAT_INFORMACE_O_SLOVU_Z_UPLNEHO_SLOVNIKU(slovo,atributy);
                            //nic jiz nenalezeno, vyhleda se slovo ve slovniku

  return;
 }

void PROCISTI_SLOVA_PODLE_ATRIBUTU(char *informace,BYTE atributy) {
     //Tuto funkci je nutno spouštìt, i když jsou atributy 0.
     //To taky nìco znamená! (vypuštìní slov závislých na pøíponì)
  //"Atributy":   bity: 0 0 0 0 ? ? ? ?
  //                            | | | |- superlativ "nej"
  //                            | | |--- zaporka "ne"
  //                            | |----- jina predpona (vy, za, pred atd.)
  //                            |------- "..at" -> "..át" (pouze vzory bere, dìlá)

WORD pozice1,pozice2,pozice3,celkem;

  if ((atributy&1) == 1) {                //superlativ "nej"
            //muzou mit pouze pridavna jmena 2. stupne jakehokoli puvodu
    celkem=strlen(informace);
    for (pozice1=0,pozice2=0; pozice1 < celkem; pozice1++) {
      if (VRAT_SLOVNI_DRUH(informace[pozice1+2]) == 2) {
                  //pozice1+2(3) bajty  =  2 bajty (cislo slova) + 1 bajt (vzor)
        for (pozice3=pozice1+3; informace[pozice3] != ',' && pozice3 < celkem; pozice3++) {
          if (strncmp(informace+pozice3,"4>",2) == 0) goto DALNEJ;   //odpovida
         }
        pozice1=pozice3;                                   //neodpovida
        for ( ; informace[pozice3] != '>' && pozice3 < celkem; pozice3++);
                                                       //dojetí na konec
        continue;
         
        DALNEJ:
        informace[pozice2++]=informace[pozice1++];
        informace[pozice2++]=informace[pozice1++];   //zkopirovani prvnich 3 bajtu
        informace[pozice2++]=informace[pozice1++];
        for (; informace[pozice1] != ',' && pozice1 < celkem; pozice1++,pozice2++)
         informace[pozice2]=informace[pozice1];
        informace[pozice2++]=informace[pozice1];
       }                                            //zkopiruji slovo
      else {
        for (pozice1+=3; informace[pozice1] != ',' && pozice1 < celkem; pozice1++);
       }                                            //dojedu na konec slova
     }
	if (pozice2 > 0) pozice2--;        //pokud nejsi na zacatku, smaz carku na konci
    informace[pozice2]=0;
   }

  if ((atributy&2) == 2) {                //zaporka "ne"
            //muzou mit pouze slovesa, pridavna jmena, popr. jejich odvozeniny
    celkem=strlen(informace);
    for (pozice1=0,pozice2=0; pozice1 < celkem; pozice1++) {
      if (informace[pozice1+3] == '5' || informace[pozice1+3] == '2' || VRAT_SLOVNI_DRUH(informace[pozice1+2]) == 12 /* byt */) {
                  //pozice1+3 bajty  =  2 bajty (cislo slova) + 1 bajt (vzor)
        informace[pozice2++]=informace[pozice1++];
        informace[pozice2++]=informace[pozice1++];   //zkopirovani prvnich 3 bajtu
        informace[pozice2++]=informace[pozice1++];
        for (; informace[pozice1] != ',' && pozice1 < celkem; pozice1++,pozice2++)
         informace[pozice2]=informace[pozice1];
        informace[pozice2++]=informace[pozice1];
       }                                            //zkopiruji slovo
      else {
        for (pozice1+=3; informace[pozice1] != ',' && pozice1 < celkem; pozice1++);
       }                                            //dojedu na konec slova
     }
	if (pozice2 > 0) pozice2--;        //pokud nejsi na zacatku, smaz carku na konci
    informace[pozice2]=0;
   }

  if ((atributy&4) == 4) {                //predpona
                           //muzou mit pouze slovesa v jakemkoli tvaru
    celkem=strlen(informace);
    for (pozice1=0,pozice2=0; pozice1 < celkem; pozice1++) {
      if (informace[pozice1+3] == '5') {
                  //pozice1+3 bajty  =  2 bajty (cislo slova) + 1 bajt (vzor)
        informace[pozice2++]=informace[pozice1++];
        informace[pozice2++]=informace[pozice1++];   //zkopirovani prvnich 3 bajtu
        informace[pozice2++]=informace[pozice1++];
        for (; informace[pozice1] != ',' && pozice1 < celkem; pozice1++,pozice2++)
         informace[pozice2]=informace[pozice1];
        informace[pozice2++]=informace[pozice1];
       }                                            //zkopiruji slovo
      else {
        for (pozice1+=3; informace[pozice1] != ',' && pozice1 < celkem; pozice1++);
       }                                            //dojedu na konec slova
     }
    if (pozice2 > 0) pozice2--;   //pokud nejsi na zacatku, smaz carku na konci
    informace[pozice2]=0;
   }
  else {//pokud slovo predponu nema, vynechaji se vsechna slova na predpone zavisla
    celkem=strlen(informace);
    for (pozice1=0,pozice2=0; pozice1 < celkem; pozice1++) {
      if (informace[pozice1+3] != '5' || informace[pozice1+4] != 'E') {
                  //pozice1+3 bajty  =  2 bajty (cislo slova) + 1 bajt (vzor)
        for (; informace[pozice1] != ',' && pozice1 < celkem; pozice1++,pozice2++)
         informace[pozice2]=informace[pozice1];
        informace[pozice2++]=informace[pozice1];
       }                                            //zkopiruji slovo
      else {
        for (; informace[pozice1] != ',' && pozice1 < celkem; pozice1++);
       }                                      //dojedu na konec slova
     }
    if (pozice2 > 0) pozice2--;        //pokud nejsi na zacatku, smaz carku na konci
    informace[pozice2]=0;
   }
  
  if ((atributy&8) == 8) {        //vytøídìní po zmìnì "-at" na "-át"
  //muzou mit pouze slovesa vzoru bere a dìlá (napø. sebrat - brát)
                //a musí mít slabikotvornou pøedponu
    celkem=strlen(informace);
    for (pozice1=0,pozice2=0; pozice1 < celkem; pozice1++) {
      if (informace[pozice1+2] == _bere_ || informace[pozice1+2] == _dela_) {
                  //pozice1+2(3) bajty  =  2 bajty (cislo slova) + 1 bajt (vzor)
        informace[pozice2++]=informace[pozice1++];
        informace[pozice2++]=informace[pozice1++];   //zkopirovani prvnich 3 bajtu
        informace[pozice2++]=informace[pozice1++];
        for (; informace[pozice1] != ',' && pozice1 < celkem; pozice1++,pozice2++)
         informace[pozice2]=informace[pozice1];
        informace[pozice2++]=informace[pozice1];
       }                                            //zkopiruji slovo
      else {
        for (pozice1+=3; informace[pozice1] != ',' && pozice1 < celkem; pozice1++);
       }                                            //dojedu na konec slova
     }
	if (pozice2 > 0) pozice2--;        //pokud nejsi na zacatku, smaz carku na konci
    informace[pozice2]=0;
   }


 }

void VYMAZ_FRONTU_UPLNEHO_SLOVNIKU(void) {
  g_nalezeneinformaceoslove[0]=0;
 }

void POROZUMEJ_VETE_NAPSANE_CLOVEKEM(char *veta) {
char *slovo=NULL,pismena,znak;
WORD pocetslov,poziceslova,pozicecislo,pozice1,pozice2,celkem=strlen(veta),*cislaslov=NULL;
Typ_slova novevyznamy;

  g_vetacloveka.VYNULUJ_HODNOTY();

  for (pozice1=0,pocetslov=0,pismena=0; pozice1 < celkem; pozice1++) {
    znak=veta[pozice1];
    if (JELI_PISMENO(znak) == 1 && pismena == 0) {
      pocetslov++; pismena=1;
     }
    else if (JELI_PISMENO(znak) == 0 && pismena == 1) {
      pismena=0;
     }
    if (znak == '?') g_vetacloveka.typ_vety=_veta_tazaci_;
    if (znak == '!') g_vetacloveka.typ_vety=_veta_rozkazovaci_;
   }                                     //spocitani poctu slov

  if (pocetslov > MAX_POCET_SLOV_CLOVEKA) pocetslov=MAX_POCET_SLOV_CLOVEKA;

  slovo=ALOKUJ_RETEZEC(strlen(veta)+1);

  for (pozice1=0,poziceslova=0; poziceslova < pocetslov; poziceslova++) {
    for (pozice2=0,pismena=0; ; pozice1++) {
      znak=veta[pozice1];
      if (JELI_PISMENO(znak) == 0) {
        if (pismena == 1) { slovo[pozice2]=0; break; }
       }
      else {
        slovo[pozice2]=znak; pozice2++; pismena=1;
        if (znak == 0) break;
       }
     }
    if (strlen(slovo) >= DELKA_JEDNODUCHEHO_SLOVA) slovo[DELKA_JEDNODUCHEHO_SLOVA-1]=0;

    VYMAZ_FRONTU_UPLNEHO_SLOVNIKU();

    novevyznamy=KOMPLETNE_VRAT_INFORMACE_O_SLOVU_Z_UPLNEHO_SLOVNIKU(slovo,0);

    if (novevyznamy.pocetslov == 0) {
//      ZAPIS_INFORMACI_O_NEZNAMEM_SLOVE(slovo);
     }

    g_vetacloveka.slova[poziceslova].PRIPOJ(novevyznamy);
    g_vetacloveka.pocetslov=poziceslova+1;
    sprintf(g_vetacloveka.slova[poziceslova].vlastnislovo,slovo);
    novevyznamy.VYMAZ_OBSAH();
   }                            //zkopirovani vyznamu slov do "g_vetacloveka.slova"

  UVOLNI(slovo);

  cislaslov=(WORD *)ALOKUJ_PAMET(DELKA_INFORMACI*sizeof(WORD));
  for (poziceslova=0; poziceslova < pocetslov; poziceslova++) {
    for (pozicecislo=0; pozicecislo < g_vetacloveka.slova[poziceslova].pocetslov; pozicecislo++) {
      cislaslov[pozicecislo]=g_vetacloveka.slova[poziceslova].id_slova[pozicecislo];
     }                                     //zjisteni vsech cisel slov

    for (pozice1=0; pozice1 < pozicecislo; pozice1++) {
      if (cislaslov[pozice1] == 0xFFFF) continue;          //zde uz bylo cislo vyhozeno
      for (pozice2=pozice1+1; pozice2 < pozicecislo; pozice2++) {
        if (cislaslov[pozice2] == cislaslov[pozice1]) cislaslov[pozice2]=0xFFFF;
       }
     }                                 //vsechna cisla slov at jsou jen jednou

    for (pozice1=0,pozice2=0; pozice1 < pozicecislo; pozice1++) {
      if (cislaslov[pozice1] != 0xFFFF) {
        cislaslov[pozice2]=cislaslov[pozice1]; pozice2++;
       }
     }                           //seskupeni cisel dohromady
    pozicecislo=pozice2;

    for (pozice1=0; pozice1 < pozicecislo; pozice1++) {
      if (cislaslov[pozice1] == 0) NAPIS_TEXT_V_LATIN_2("Speciální_slovo ");
      else {
        VRAT_SLOVO_ZE_ZAKLADNIHO_SLOVNIKU(cislaslov[pozice1]);
        ODUPRAV_SLOVO_PRO_IQPOKYD(g_slovozaklad);
        NAPIS_TEXT_V_LATIN_2(g_slovozaklad); printf(" ");
       }
     }
   }
  UVOLNI(cislaslov);
 }

