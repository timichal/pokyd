WORD DOPLN_DO_TYP_SLOVA_ATRIBUTY_DANE_RETEZCEM(Typ_slova trida,WORD poziceslova,char *atributy) {
 //"trida" musi byt jiz vytvoreny Typ_slova, atributy jsou atributy v retezci
  //atributy uz musi obsahovat jen samotne atributy bez binarnich informaci
  //(tedy bez vzoru, cisla slova, predpony atd.), ale vcetne vnoreni
 //"atributy" muzou koncit znaky '\x0', ',' nebo '}'.

//Funkce vraci pocet prectenych znaku (pro snadne pokracovani v textu)

WORD pozice1,pozice2;

  pozice1=0;
  if (atributy[pozice1] == '(') {   //na zacatku je textovy "id_cisla"
    pozice1++;   //posun za znak '('
    for (trida.id_slova[poziceslova]=0; atributy[pozice1] != ')'; pozice1++) {
      trida.id_slova[poziceslova]*=10;
      trida.id_slova[poziceslova]+=atributy[pozice1]-'0';
     }
    pozice1++;   //posun za znak ')'

    VRAT_SLOVO_ZE_ZAKLADNIHO_SLOVNIKU(trida.id_slova[poziceslova]);
    trida.UPRAV_VZOR(g_informaceoslove[0],poziceslova);   //vzor
   }
  for (pozice2=0; atributy[pozice1] != '>'; pozice1++,pozice2++) {  //vnoreni
    if (atributy[pozice1] == '?') {
      if (atributy[pozice1+1] != '>') {
        NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_); // printf("Chyba!!! Otaznik muze byt ve vnoreni pouze na konci!")
       }
      if (pozice1 == 0) { //pokud je zde otaznik sam, necha se tam
                          //to, co zde bylo. Pokud je az za nejakym
                          //cislem, je to v podmince a napise se
                          //i s otaznikem
        if (trida.vnoreni[poziceslova][0] == 0) {
          strcpy(trida.vnoreni[poziceslova],"?");  //jedna se o relativni atribut pro porovnavani
          trida.tvar[poziceslova]=255;       //take tvar je v tomto pripade libovolny
         }
        pozice1++; goto DAL;     //ve vnoreni se necha to, co tam uz bylo
       }
     }
    trida.vnoreni[poziceslova][pozice2]=atributy[pozice1];
   }
  trida.vnoreni[poziceslova][pozice2]=0;
DAL:
  pozice1++;                      //preskoceni znaku '>' (konec vnoreni)

                         //doplneni slovniho druhu podle vnoreni
  switch(trida.vnoreni[poziceslova][0]) {
    case 'C': trida.slovnidruh[poziceslova]=12; break;   //zajmeno "byt"
    case '0': trida.slovnidruh[poziceslova]=10; break;   //citoslovce
    default: if (trida.vnoreni[poziceslova][0] >= '1' && trida.vnoreni[poziceslova][0] <= '9')
              trida.slovnidruh[poziceslova]=trida.vnoreni[poziceslova][0]-'0';
                                             //slovni druhy 0-9
             else if (trida.vnoreni[poziceslova][0] == '?');
                      //nespecifikovany slovni druh
             else NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
             break;
   }

  //pokud je to zajmeno, urci se vzor z vnoreni (a vnoreni ma dokonce prednost)
  if (trida.vnoreni[poziceslova][0] == '3') {
    if (trida.vnoreni[poziceslova][1] >= '1' && trida.vnoreni[poziceslova][1] <= '7')
     trida.vzor[poziceslova]=trida.vnoreni[poziceslova][1]-'0'-1+_osobni_;
    else NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
   }

  for (; atributy[pozice1] != ',' && atributy[pozice1] != '}' && atributy[pozice1] != 0; pozice1++) {
    switch(atributy[pozice1]) {
      case '1': case '2': case '3': case '4': case '5': case '6': case '7':  //pad
        trida.pad[poziceslova]=atributy[pozice1]-'0'; break;
      case 'n': case 'o': case 'p': case 'q':                       //osoba
        trida.osoba[poziceslova]=atributy[pozice1]-'n'; break;
      case 'y': trida.cislo[poziceslova]=1; break;             //cislo
      case 'Y': trida.cislo[poziceslova]=2; break;
      case 'i': case 'j': case 'k': case 'l': case 'm':             //cas
        trida.cas[poziceslova]=atributy[pozice1]-'i'+1; break;
      case 'r': case 's': case 't':                                 //rod
        trida.rod[poziceslova]=atributy[pozice1]-'r'+1; break;
      case 'z': trida.zivotnost[poziceslova]=0; break;         //zivotnost
      case 'Z': trida.zivotnost[poziceslova]=1; break;
      case 'x': trida.cislopredmetu[poziceslova]=1; break;     //cislopredmetu
      case 'X': trida.cislopredmetu[poziceslova]=2; break;
      case 'a': case 'b': case 'c':                                 //rodpredmetu
        trida.rodpredmetu[poziceslova]=atributy[pozice1]-'a'+1; break;
      case 'd': case 'e': case 'f':                             //vid
        trida.vid[poziceslova]=atributy[pozice1]-'d'; break;
      case 'V': trida.vid[poziceslova]=1; break;
      case 'A': case 'B': case 'C': case 'D': case 'E': case 'F': case 'G': case 'H': case 'I': case 'J': case 'K': //tvar
        trida.tvar[poziceslova]=atributy[pozice1]-'A'; break;
      case 'M': case 'N': case 'O': case 'P': case 'Q': case 'R': case 'S': case 'T': //pridavek
        trida.pridavek[poziceslova]=atributy[pozice1]-'M'; break;
      case 'w': trida.zapor[poziceslova]=0; break;         //zapor
      case 'W': trida.zapor[poziceslova]=1; break;
      default:
        NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_); // printf("Chyba!!! Spatny znak v retezci atributy o slove.");
     }
   }
  return(pozice1);
 }

void VYMAZ_NEPODSTATNE_ATRIBUTY_PRO_PREVOD_SLOVA(Typ_slova atributy,Typ_slova zcehovzniklo,WORD pozicevpuvodnim) {
//Pokud chceme pøevést 1 slovo na jiné a "zdìdit" jeho vlastnosti,
//mùžou být nìkteré atributy nechtìné (napø. "tvar" pøi pøevodu
//pøídavného jména na zájmeno).
//Tato funkce se volá PO KONVERZI, ale PRED UMELYMI UPRAVAMI
//Parametr "zcehovzniklo" je zde proto, aby funkce vìdìla, co všechno
//je nežádoucí.
  if (atributy.slovnidruh[0] != zcehovzniklo.slovnidruh[pozicevpuvodnim]) {
    atributy.tvar[0]=0;       //tvar je standardne 0
    atributy.pridavek[0]=255;
   }

  if (atributy.osoba[0] == 1) atributy.osoba[0]=2;
  else if (atributy.osoba[0] == 2) atributy.osoba[0]=1;
   //1. osoba se pøevede na 2. a naopak
   //Je to proto, že když øeknu "nemám nic", poèítaè odpoví "nemáš nic"
   //Pokud je osoba pevnì definována, pøepíše se znova ve funkci
   //DOPLN_DO_TYP_SLOVA_ATRIBUTY_DANE_RETEZCEM volané hned za touto funkcí
 }

Typ_slova PREVED_NA_TRIDU_TYP_SLOVA(char *informace,BYTE dalsiatributy,char *predpona,BYTE binarniinformace) {
   //tato funkce prevede retezec obsahujici informace o slove, ktery je napsany
   //v uplne databazi slov, na strukturovanou tridu typu "Typ_slova".
   //"dalsiatributy" urcuji dalsi atributy, ktere se pridaji ke vsem slovum
   //a jsou uvedeny ve funkci KOMPLETNE_VRAT_INFORMACE_O_SLOVU_Z_UPLNEHO_SLOVNIKU.
   //"binarniinformace" muze byt 1 nebo 0. Pokud je 1, "informace"
   //obsahuji i cislo slova a vzor
   //POKUD NEJSOU BINARNI INFORMACE, MUZE BYT POUZE 1 SLOVO
Typ_slova nova_trida;
WORD pocetslov,poziceslova;
BYTE slovnidruh;
int pozice;

  if (informace[0] == 0) {
    nova_trida.VYTVOR_NOVY(0);          //aby se vytvorila alespon kostra tridy
    return(nova_trida);
   }

  if (binarniinformace == 1) {
    for (pozice=3,pocetslov=1; informace[pozice] != 0; pozice++) {
      if (informace[pozice] == ',') {
        pocetslov++; pozice+=3;          //preskoc cislo slova a vzor
       }
     }                                                 //spocitani poctu slov
   }
  else pocetslov=1;
  nova_trida.VYTVOR_NOVY(pocetslov);

  for (poziceslova=0,pozice=0; poziceslova < pocetslov; poziceslova++,pozice++) {
    nova_trida.NASTAV_POCATECNI_HODNOTY(poziceslova);

    if (binarniinformace == 1) {
      nova_trida.id_slova[poziceslova]=(WORD)((BYTE)(informace[pozice++]-1));
      nova_trida.id_slova[poziceslova]*=255;
      nova_trida.id_slova[poziceslova]+=(WORD)((BYTE)(informace[pozice++]-1));

      slovnidruh=(BYTE)informace[pozice++];
     }
    else {
      nova_trida.id_slova[poziceslova]=65535;
      slovnidruh=255;
     }

    strcpy(nova_trida.predpona[poziceslova],predpona);

    pozice+=DOPLN_DO_TYP_SLOVA_ATRIBUTY_DANE_RETEZCEM(nova_trida,poziceslova,informace+pozice);

    nova_trida.UPRAV_VZOR(slovnidruh,poziceslova);

    if (nova_trida.slovnidruh[poziceslova] == 1) {
                   //u podstatnych jmen se doplni rod, ktery je zrejmy ze vzoru
      switch(nova_trida.vzor[poziceslova]) {
        case _pan_: case _hrad_: case _muz_: case _stroj_: case _predseda_: case _soudce_: case _rony_:
          nova_trida.rod[poziceslova]=1; break;              //muzsky rod
        case _zena_: case _ruze_: case _pisen_: case _kost_: case _idea_: case _madam_: case _kalhoty_: case _housle_:
          nova_trida.rod[poziceslova]=2; break;              //zensky rod
        case _mesto_: case _more_: case _kure_: case _staveni_: case _tema_: case _kupe_: case _data_:
          nova_trida.rod[poziceslova]=3; break;              //stredni rod
        default: NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
       }
      switch(nova_trida.vzor[poziceslova]) {
        case _pan_: case _muz_: nova_trida.zivotnost[poziceslova]=1; break; //zivotne
        case _hrad_: case _stroj_: nova_trida.zivotnost[poziceslova]=0; break; //nezivotne
       }
      nova_trida.osoba[poziceslova]=3;     //podstatné jméno je vždy 3. osoby
     }
    if (nova_trida.slovnidruh[poziceslova] == 5
     && nova_trida.rod[poziceslova] == 255) {
      //u sloves se doplni rod podle puvodce deje (tedy u 1. osoby
      // rod cloveka, u 2. osoby rod pocitace)
      if (nova_trida.osoba[poziceslova] == 1) nova_trida.rod[poziceslova]=g_nastaveni.pohlavicloveka;
      if (nova_trida.osoba[poziceslova] == 2) nova_trida.rod[poziceslova]=g_nastaveni.pohlavipocitace;
     }
    if (nova_trida.slovnidruh[poziceslova] == 6) {
  //u prislovci se doplni tvar, ktery odpovida vzoru (kvuli snazsi identifikaci)
      switch(nova_trida.vzor[poziceslova]) {
        case _mista_kde_: nova_trida.tvar[poziceslova]=1; break;
        case _mista_kam_: nova_trida.tvar[poziceslova]=2; break;
        case _casu_: nova_trida.tvar[poziceslova]=3; break;
        case _zpusobu_: nova_trida.tvar[poziceslova]=4; break;
        case _otazky_: nova_trida.tvar[poziceslova]=5; break;
        default: NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
       }
     }      
   }
  return(nova_trida);
 }

char *PREVED_Z_TRIDY_TYP_SLOVA_NA_RETEZEC(Typ_slova slovo,WORD poziceslova) {
   //tato funkce prevede slovo "Typ_slova" na retezec urcene "pozici"
   //(vraci pointer, ktery alokuje)
   //VRACI POUZE ATRIBUTOVE INFORMACE O SLOVE, V ZADNEM PRIPADE TO NENI OPAK
   //K PREDCHOZI FUNKCI
char *informace=NULL;
int pozice;

  informace=ALOKUJ_RETEZEC(MAX_DELKA_SLOVA);

  if (poziceslova >= slovo.pocetslov) {
    informace[0]=0; return(informace);         //vrat prazdny retezec
   }

  pozice=0;
  if (slovo.pad[poziceslova] != 255) informace[pozice++]=slovo.pad[poziceslova]+'0';
  if (slovo.osoba[poziceslova] != 255) informace[pozice++]=slovo.osoba[poziceslova]+'n';
  if (slovo.cislo[poziceslova] != 255) informace[pozice++]='y'-(slovo.cislo[poziceslova]-1)*32;
  if (slovo.cas[poziceslova] != 255) informace[pozice++]=slovo.cas[poziceslova]+'i'-1;
  if (slovo.rod[poziceslova] != 255) informace[pozice++]=slovo.rod[poziceslova]+'r'-1;
  if (slovo.zivotnost[poziceslova] != 255) informace[pozice++]='z'-slovo.zivotnost[poziceslova]*32;
  if (slovo.cislopredmetu[poziceslova] != 255) informace[pozice++]='x'-(slovo.cislopredmetu[poziceslova]-1)*32;
  if (slovo.rodpredmetu[poziceslova] != 255) informace[pozice++]=slovo.rodpredmetu[poziceslova]+'a'-1;
  if (slovo.vid[poziceslova] != 255) informace[pozice++]='d'+slovo.vid[poziceslova];
  if (slovo.tvar[poziceslova] != 0) informace[pozice++]=slovo.tvar[poziceslova]+'A';
  if (slovo.pridavek[poziceslova] != 255) informace[pozice++]=slovo.pridavek[poziceslova]+'M';
  informace[pozice]=0;

  return(informace);
 }

void ALOKUJ_VSECHNY_PRVKY_G_VETACLOVEKA(void) {
WORD poziceslova;
  for (poziceslova=0; poziceslova < MAX_POCET_SLOV_CLOVEKA; poziceslova++) {
    g_vetacloveka.slova[poziceslova].VYTVOR_NOVY(0);
   }
  g_vetacloveka.pocetslov=0;

  g_vetacloveka.podmet.VYTVOR_NOVY(0);
  g_vetacloveka.podmet.pocetslov=0;

  g_vetacloveka.prisudek.VYTVOR_NOVY(0);
  g_vetacloveka.prisudek.pocetslov=0;

  g_vetacloveka.predmet.VYTVOR_NOVY(0);
  g_vetacloveka.predmet.pocetslov=0;
 }

void VYNULUJ_VSECHNY_PRVKY_G_VETACLOVEKA(void) {
WORD poziceslova;
  for (poziceslova=0; poziceslova < g_vetacloveka.pocetslov; poziceslova++) {
    g_vetacloveka.slova[poziceslova].VYNULUJ_POCET_SLOV();
   }
  g_vetacloveka.podmet.VYNULUJ_POCET_SLOV();
  g_vetacloveka.prisudek.VYNULUJ_POCET_SLOV();
  g_vetacloveka.predmet.VYNULUJ_POCET_SLOV();
 }

void PREVED_Z_LATIN_2_NA_WINDOWS_1250(char *slovo) {
char znak;
WORD pozice,celkem=strlen(slovo);
  for (pozice=0; pozice < celkem; pozice++) {
    znak=slovo[pozice];
    if ((znak >= 'A' && znak <= 'Z') || (znak >= 'a' && znak <= 'z')) {}
    else if (znak < 0) switch(znak) {
      case ' ': znak='á'; break;
      case 'µ': znak='Á'; break;
      case '‚': znak='é'; break;
      case '': znak='É'; break;
      case 'Ø': znak='ì'; break;
      case '·': znak='Ì'; break;
      case '¡': znak='í'; break;
      case 'Ö': znak='Í'; break;
      case '¢': znak='ó'; break;
      case 'à': znak='Ó'; break;
      case '£': znak='ú'; break;
      case 'é': znak='Ú'; break;
      case '…': znak='ù'; break;
      case 'Þ': znak='Ù'; break;
      case 'ì': znak='ý'; break;
      case 'í': znak='Ý'; break;
      case '§': znak='ž'; break;
      case '¦': znak='Ž'; break;
      case 'ç': znak='š'; break;
      case 'æ': znak='Š'; break;
      case 'Ÿ': znak='è'; break;
      case '¬': znak='È'; break;
      case 'ý': znak='ø'; break;
      case 'ü': znak='Ø'; break;
      case 'Ô': znak='ï'; break;
      case 'Ò': znak='Ï'; break;
      case 'œ': znak=''; break;
      case '›': znak=''; break;
      case 'å': znak='ò'; break;
      case 'Õ': znak='Ò'; break;
     }
    slovo[pozice]=znak;
   }
 }

