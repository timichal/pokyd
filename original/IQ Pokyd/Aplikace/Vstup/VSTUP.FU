void NAPIS_TEXT_V_LATIN_2(char *text) {
char *novytext=NULL;
  novytext=ALOKUJ_RETEZEC(strlen(text)+1);
  strcpy(novytext,text);
  PREVED_Z_WINDOWS_1250_NA_LATIN_2(novytext);
  printf(novytext);
  UVOLNI(novytext);
 }

void PRIDEJ_PRED_ZAKLADNI_TVAR_PREDPONU(char *predpona) {
char *docasneslovo=NULL;
  if (predpona[0] != 0) {             //pridani predpony pred slovo
    if ((strlen(predpona)+strlen(g_slovozaklad)) >= (DELKA_JEDNODUCHEHO_SLOVA-1)) {
      NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
     }
    docasneslovo=ALOKUJ_RETEZEC(DELKA_JEDNODUCHEHO_SLOVA);
    strcpy(docasneslovo,predpona);
    strcat(docasneslovo,g_slovozaklad);
    strcpy(g_slovozaklad,docasneslovo);
    UVOLNI(docasneslovo);
   }
 }

BYTE POROVNEJ_DVA_ATRIBUTY_Z_TYPU_SLOVA(BYTE atribut1,BYTE atribut2) {
 //Porovná atributy s ohledem na to, že nìkterý nemusí být urèen (hodnota 255)
 //vrací: 0 - atributy nejsou stejné
 //       1 - atributy jsou stejné
 //       2 - min. jeden z atributù není uveden, není vylouèena ani jedna možnost

  if (atribut1 == 255 || atribut2 == 255) return(2);
  else if (atribut1 == atribut2) return(1);
  else return(0);
 }

BYTE POROVNEJ_DVA_ID_SLOVA_Z_TYPU_SLOVA(WORD atribut1,WORD atribut2) {
 //Porovná atributy s ohledem na to, že nìkterý nemusí být urèen (hodnota 255)
 //vrací: 0 - atributy nejsou stejné
 //       1 - atributy jsou stejné
 //       2 - min. jeden z atributù není uveden, není vylouèena ani jedna možnost

  if (atribut1 == 65535 || atribut2 == 65535) return(2);
  else if (atribut1 == atribut2) return(1);
  else return(0);
 }

BYTE URCITE_POROVNEJ_DVA_ATRIBUTY_Z_TYPU_SLOVA(BYTE atribut1,BYTE atribut2) {
 //Porovná atributy s ohledem na to, že DRUHÝ Z NICH nemusí být urèen (hodnota 255)
 //vrací: 0 - atributy nejsou stejné
 //       1 - atributy jsou stejné
 //       2 - druhý atribut není uveden, není vylouèena ani jedna možnost

  if (atribut2 == 255) return(2);
  else if (atribut1 == atribut2) return(1);
  else return(0);
 }

BYTE POROVNEJ_VNORENI_Z_TYPU_SLOVA(char *vnoreni1,char *vnoreni2) {
 //Porovná dva atributy s vnoøením s ohledem na to, že nìkterý nebo
 //jeho èást nemusí být urèena (znak "?")
 //vrací: 0 - vnoøení nejsou stejná
 //       1 - vnoøení jsou stejná
 //       2 - vnoøení se shodují, nicménì nemusí být úplnì stejné (s "?")
WORD pozice=0;
  do {
    if (vnoreni1[pozice] == '?' || vnoreni2[pozice] == '?') return(2);
    if (vnoreni1[pozice] != vnoreni2[pozice]) return(0);
   } while (vnoreni1[pozice] != 0 && vnoreni2[ pozice++ ] != 0);
  return(1);
 }


BYTE POROVNEJ_MNOZINU_ATRIBUTU_Z_TYPU_SLOVA(WORD pocetslov2,BYTE atribut1A,BYTE *atributy1B) {
  return(POROVNEJ_MNOZINU_ATRIBUTU_Z_TYPU_SLOVA(pocetslov2,atribut1A,atributy1B,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL));
 }
BYTE POROVNEJ_MNOZINU_ATRIBUTU_Z_TYPU_SLOVA(WORD pocetslov2,BYTE atribut1A,BYTE *atributy1B,BYTE atribut2A,BYTE *atributy2B) {
  return(POROVNEJ_MNOZINU_ATRIBUTU_Z_TYPU_SLOVA(pocetslov2,atribut1A,atributy1B,atribut2A,atributy2B,NULL,NULL,NULL,NULL,NULL,NULL));
 }
BYTE POROVNEJ_MNOZINU_ATRIBUTU_Z_TYPU_SLOVA(WORD pocetslov2,BYTE atribut1A,BYTE *atributy1B,BYTE atribut2A,BYTE *atributy2B,BYTE atribut3A,BYTE *atributy3B) {
  return(POROVNEJ_MNOZINU_ATRIBUTU_Z_TYPU_SLOVA(pocetslov2,atribut1A,atributy1B,atribut2A,atributy2B,atribut3A,atributy3B,NULL,NULL,NULL,NULL));
 }
BYTE POROVNEJ_MNOZINU_ATRIBUTU_Z_TYPU_SLOVA(WORD pocetslov2,BYTE atribut1A,BYTE *atributy1B,BYTE atribut2A,BYTE *atributy2B,BYTE atribut3A,BYTE *atributy3B,BYTE atribut4A,BYTE *atributy4B) {
  return(POROVNEJ_MNOZINU_ATRIBUTU_Z_TYPU_SLOVA(pocetslov2,atribut1A,atributy1B,atribut2A,atributy2B,atribut3A,atributy3B,atribut4A,atributy4B,NULL,NULL));
 }
BYTE POROVNEJ_MNOZINU_ATRIBUTU_Z_TYPU_SLOVA(WORD pocetslov2,BYTE atribut1A,BYTE *atributy1B,BYTE atribut2A,BYTE *atributy2B,BYTE atribut3A,BYTE *atributy3B,BYTE atribut4A,BYTE *atributy4B,BYTE atribut5A,BYTE *atributy5B) {
 //Porovná atributy jednoho významu s množinou atributù (jejich poèet je dán poètem
 //parametrù) více významù (hledá tedy napø. shodu podmìtu
 //s pøísudkem v jednom významu podmìtu) na zadané atributy

 //Vrací: 0 - v množinì nejsou žádná shodná slova
 //       1 - alespoò 1 slovo je shodné nebo je prázdná množina (a tudíž vyhovuje)

char *shodnaslova=NULL;
WORD pozice;
BYTE navrat;

  if (pocetslov2 == 0) return(1);         //pokud 1 z nic neexistuje, není
                                          //dùvod, proè by tam ten druhý nemìl být

  shodnaslova=ALOKUJ_RETEZEC(pocetslov2+1);

  for (pozice=0; pozice < pocetslov2; pozice++)
   shodnaslova[pozice]='*';        //nastavení shodných slov
  shodnaslova[pozice]=0;    //aby to bylo hezké :-)

  if (atribut1A == NULL) goto SPOCITEJ;
  for (pozice=0; pozice < pocetslov2; pozice++) {
    if (POROVNEJ_DVA_ATRIBUTY_Z_TYPU_SLOVA(atribut1A,atributy1B[pozice]) == 0)
     shodnaslova[pozice]=' ';   //"vymazání" nevyhovujících slov
   }

  if (atribut2A == NULL) goto SPOCITEJ;
  for (pozice=0; pozice < pocetslov2; pozice++) {
    if (POROVNEJ_DVA_ATRIBUTY_Z_TYPU_SLOVA(atribut2A,atributy2B[pozice]) == 0)
     shodnaslova[pozice]=' ';   //"vymazání" nevyhovujících slov
   }

  if (atribut3A == NULL) goto SPOCITEJ;
  for (pozice=0; pozice < pocetslov2; pozice++) {
    if (POROVNEJ_DVA_ATRIBUTY_Z_TYPU_SLOVA(atribut3A,atributy3B[pozice]) == 0)
     shodnaslova[pozice]=' ';   //"vymazání" nevyhovujících slov
   }

  if (atribut4A == NULL) goto SPOCITEJ;
  for (pozice=0; pozice < pocetslov2; pozice++) {
    if (POROVNEJ_DVA_ATRIBUTY_Z_TYPU_SLOVA(atribut4A,atributy4B[pozice]) == 0)
     shodnaslova[pozice]=' ';   //"vymazání" nevyhovujících slov
   }

  if (atribut5A == NULL) goto SPOCITEJ;
  for (pozice=0; pozice < pocetslov2; pozice++) {
    if (POROVNEJ_DVA_ATRIBUTY_Z_TYPU_SLOVA(atribut5A,atributy5B[pozice]) == 0)
     shodnaslova[pozice]=' ';   //"vymazání" nevyhovujících slov
   }

  SPOCITEJ:
  navrat=0;
  for (pozice=0; pozice < pocetslov2; pozice++) {
    if (shodnaslova[pozice] == '*') { navrat=1; break; }
   }                                //spoèítání návratové hodnoty
  UVOLNI(shodnaslova);
  return(navrat);
 }

BYTE PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(Typ_slova slova1,WORD pocetslov1,WORD pocetslov2,BYTE *atributy1A,BYTE *atributy1B) {
  return(PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(slova1,pocetslov1,pocetslov2,atributy1A,atributy1B,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL));
 }
BYTE PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(Typ_slova slova1,WORD pocetslov1,WORD pocetslov2,BYTE *atributy1A,BYTE *atributy1B,BYTE *atributy2A,BYTE *atributy2B) {
  return(PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(slova1,pocetslov1,pocetslov2,atributy1A,atributy1B,atributy2A,atributy2B,NULL,NULL,NULL,NULL,NULL,NULL));
 }
BYTE PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(Typ_slova slova1,WORD pocetslov1,WORD pocetslov2,BYTE *atributy1A,BYTE *atributy1B,BYTE *atributy2A,BYTE *atributy2B,BYTE *atributy3A,BYTE *atributy3B) {
  return(PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(slova1,pocetslov1,pocetslov2,atributy1A,atributy1B,atributy2A,atributy2B,atributy3A,atributy3B,NULL,NULL,NULL,NULL));
 }
BYTE PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(Typ_slova slova1,WORD pocetslov1,WORD pocetslov2,BYTE *atributy1A,BYTE *atributy1B,BYTE *atributy2A,BYTE *atributy2B,BYTE *atributy3A,BYTE *atributy3B,BYTE *atributy4A,BYTE *atributy4B) {
  return(PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(slova1,pocetslov1,pocetslov2,atributy1A,atributy1B,atributy2A,atributy2B,atributy3A,atributy3B,atributy4A,atributy4B,NULL,NULL));
 }

BYTE PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(Typ_slova slova1,WORD pocetslov1,WORD pocetslov2,BYTE *atributy1A,BYTE *atributy1B,BYTE *atributy2A,BYTE *atributy2B,BYTE *atributy3A,BYTE *atributy3B,BYTE *atributy4A,BYTE *atributy4B,BYTE *atributy5A,BYTE *atributy5B) {
 //Porovná dva "Typ_slova" v množinì atributù (jejich poèet je dán poètem
 //parametrù) v celé délce parametrù obou množin (hledá tedy napø. shodu podmìtu
 //s pøísudkem v množinì slov na zadané atributy
 //Ve slova1 zùstanou v výrazy PRVNÍHO slova, které se vyskytují i v druhém výrazu.

 //Vrací: 0 - v množinì nejsou žádná shodná slova
 //       1 - alespoò 1 slovo je shodné

char *shodnaslovated=NULL,*shodnaslovacelkove=NULL;
WORD pozice,poz1,poz2;
BYTE navrat;

  shodnaslovacelkove=ALOKUJ_RETEZEC(pocetslov1+1);

  for (pozice=0; pozice < pocetslov1; pozice++)
   shodnaslovacelkove[pozice]='*';        //nastavení shodných slov
  shodnaslovacelkove[pozice]=0;    //aby to bylo hezké :-)

  if (atributy1A == NULL) goto PREVED_NA_TYP_SLOVA;
  shodnaslovated=X_PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(pocetslov1,pocetslov2,atributy1A,atributy1B);
  for (pozice=0; pozice < pocetslov1; pozice++) {
    if (shodnaslovated[pozice] == ' ') shodnaslovacelkove[pozice]=' ';
   }                                //"vymazání" nevyhovujících slov
  UVOLNI(shodnaslovated);

  if (atributy2A == NULL) goto PREVED_NA_TYP_SLOVA;
  shodnaslovated=X_PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(pocetslov1,pocetslov2,atributy2A,atributy2B);
  for (pozice=0; pozice < pocetslov1; pozice++) {
    if (shodnaslovated[pozice] == ' ') shodnaslovacelkove[pozice]=' ';
   }                                //"vymazání" nevyhovujících slov
  UVOLNI(shodnaslovated);

  if (atributy3A == NULL) goto PREVED_NA_TYP_SLOVA;
  shodnaslovated=X_PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(pocetslov1,pocetslov2,atributy3A,atributy3B);
  for (pozice=0; pozice < pocetslov1; pozice++) {
    if (shodnaslovated[pozice] == ' ') shodnaslovacelkove[pozice]=' ';
   }                                //"vymazání" nevyhovujících slov
  UVOLNI(shodnaslovated);

  if (atributy4A == NULL) goto PREVED_NA_TYP_SLOVA;
  shodnaslovated=X_PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(pocetslov1,pocetslov2,atributy4A,atributy4B);
  for (pozice=0; pozice < pocetslov1; pozice++) {
    if (shodnaslovated[pozice] == ' ') shodnaslovacelkove[pozice]=' ';
   }                                //"vymazání" nevyhovujících slov
  UVOLNI(shodnaslovated);

  if (atributy5A == NULL) goto PREVED_NA_TYP_SLOVA;
  shodnaslovated=X_PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(pocetslov1,pocetslov2,atributy5A,atributy5B);
  for (pozice=0; pozice < pocetslov1; pozice++) {
    if (shodnaslovated[pozice] == ' ') shodnaslovacelkove[pozice]=' ';
   }                                //"vymazání" nevyhovujících slov
  UVOLNI(shodnaslovated);

  PREVED_NA_TYP_SLOVA:
  navrat=0;
  for (pozice=0; pozice < pocetslov1; pozice++) {
    if (shodnaslovacelkove[pozice] == '*') { navrat=1; break; }
   }                                //spoèítání návratové hodnoty

  for (poz1=0,poz2=0; poz1 < pocetslov1; poz1++) {
    if (shodnaslovacelkove[poz1] == '*') {
      slova1.ZKOPIRUJ_JEDNO_SLOVO_Z_TYP_SLOVA(poz2,poz1);
      poz2++;
     }
   }
  for (; poz2 < pocetslov1++; poz2++) {
    slova1.VYMAZ_POSLEDNI_POZICI();        //smazání zbývajících slov
   }

  return(navrat);
 }

char *X_PROTRID_SLOVA_DLE_JINEHO_SLOVA_S_ATRIBUTY(WORD pocetslov1,WORD pocetslov2,BYTE *atributy1,BYTE *atributy2) {
 // tato funkce je "podfunkcí" pøedchozí funkce, RADÌJI NEPOUŽÍVAT SAMOSTATNÌ!
 // vrací alokovaný øetìzec obsahující mezery (nic) a hvìzdièky (shoda)
char *stejneatributy=NULL;
WORD pozice1,pozice2;

  stejneatributy=ALOKUJ_RETEZEC(pocetslov1+1);

  for (pozice1=0; pozice1 < pocetslov1; pozice1++) {
    stejneatributy[pozice1]=' ';
    for (pozice2=0; pozice2 < pocetslov2; pozice2++) {
      if (POROVNEJ_DVA_ATRIBUTY_Z_TYPU_SLOVA(atributy1[pozice1],atributy2[pozice2]) != 0) {
        stejneatributy[pozice1]='*'; break;
       }
     }
   }
  stejneatributy[pozice1]=0;

  return(stejneatributy);
 }

void DOPLN_ATRIBUTY_TYPU_SLOVA(BYTE &atribut1,BYTE &atribut2) {
 //Doplní atributy jednoho slova podle atributù druhého slova a naopak
  if (atribut1 == 255 && atribut2 != 255) atribut1=atribut2;
  else if (atribut2 == 255 && atribut1 != 255) atribut2=atribut1;
 }
