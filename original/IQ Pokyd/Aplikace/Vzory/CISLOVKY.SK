BYTE navrat=0;
char *slovavefronte2=NULL;
int pozice;
  slovavefronte2=ALOKUJ_RETEZEC(DELKA_FRONTY);

  switch(cislovka) {
    case 2: VYMAZ_FRONTU(); strcpy(g_slovozaklad,"polovina");
            SKLONUJ_VZOR_ZENA(pad,cislo); strcpy(slovavefronte2,g_slovavefronte);
