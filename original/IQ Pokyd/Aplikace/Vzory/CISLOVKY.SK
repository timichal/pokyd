               strcpy(slovavefronte2,g_slovavefronte);
               for (pozice=1; ; pozice++) {        //vysklonuje vsechna slova
                 VYMAZ_FRONTU(); SKLONUJ_CISLOVKY_RADOVE(1,1,2,0,cislovka);
  //zensky rod je tu proto, ze je pouze jediny (miliont·, ale miliont˝ a miliontej)
                 if (OREZ_FRONTU_NA_1_SLOVO(pozice) == 0)
                                           //dulezite pro sklonovani fronty
                  break;
                 NAHRAD_CAST_CASTI("t·","ùina");
                 strcpy(g_slovozaklad,g_slovavefronte);
                 VYMAZ_FRONTU(); SKLONUJ_VZOR_ZENA(pad,cislo);
                 PRIDEJ_DO_PRECHODNE_FRONTY(slovavefronte2,g_slovavefronte);
                }
               strcpy(g_slovavefronte,slovavefronte2);
               break;
    default: navrat=0; goto UVOLNIPAMET;       //jinak zadny tvar neexistuje
   }
  navrat=1; goto UVOLNIPAMET;

  UVOLNIPAMET:
  UVOLNI(slovavefronte2);
