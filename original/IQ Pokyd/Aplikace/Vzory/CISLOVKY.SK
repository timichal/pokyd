    case 200: strcpy(g_slovozaklad,"dvouseùina"); SKLONUJ_VZOR_ZENA(pad,cislo); break;
    case 300: strcpy(g_slovozaklad,"t¯Ìseùina"); SKLONUJ_VZOR_ZENA(pad,cislo); break;
