              SKLONUJ_VZOR_ZENA(pad,cislo); strcpy(slovavefronte2,g_slovavefronte);
              VYMAZ_FRONTU(); strcpy(g_slovozaklad,"Ëtyrseùina"); //nespisovne
              SKLONUJ_VZOR_ZENA(pad,cislo); PRIDEJ_DO_PRECHODNE_FRONTY(slovavefronte2,g_slovavefronte);
              strcpy(g_slovavefronte,slovavefronte2); break;
    case 1000: strcpy(g_slovozaklad,"ùisÌcina"); SKLONUJ_VZOR_ZENA(pad,cislo); break;
    case 1001:
    case 1002:
    case 1003:
    case 1004:
    case 1005:
    case 1006:
    case 1007:
