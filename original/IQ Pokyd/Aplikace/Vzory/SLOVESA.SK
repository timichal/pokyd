  return(1);

  PRIDAV_DELANY:                   //slovesnÈ p¯ÌdavnÈ jmÈno (dÏlan˝)
  CASUJ_VZOR_SAZI(1,1,1,1,0,0,zapor,1);     //rekurze - podst. jm. (dÏl·nÌ)
  VYGENERUJ_TVAR_DELANY(g_slovavefronte);
  return(1);

  NEDOKONAVY:                      //konverze dokonavÈho vidu na nedokonav˝
                                   //pozn·mka viz v˝öe
  return(0);

  PREDMINULY:                   //"p¯edminul˝" tvar slovesa (dÏl·v·)
  strcpy(g_slovo,g_slovodocasne);
  PRIDEJ_NA_KONEC("Ìv·");
  PRIDEJ_DO_FRONTY(); return(_dela_);
 }

BYTE CASUJ_VZOR_DELA(BYTE osoba,BYTE cislo,BYTE cas,BYTE rod,BYTE vid,BYTE zivotnost,BYTE zapor,BYTE tvar) {
// Tento vzor umoûÚuje vytv·¯et slova typu "b˝v·valo" - staËÌ vytvo¯it
// nedokonav˝ tvar slovesa z jiû nedokonavÈho z·kladnÌho tvaru bez p¯edpony
// (nap¯. dÏl· => dÏl·v·)
// Tento vzor je takÈ jedin˝m vzorem, kter˝ m· zcela pravidelnÈ skloÚov·nÌ
// i tvo¯enÌ r˘zn˝ch tvar˘. (KÈû by takov˝ch vzor˘ bylo vÌc :-) )

  strcpy(g_slovodocasne,g_slovozaklad);
  OREZ_O_SAMOHLASKU(g_slovodocasne);

  switch(tvar) {
    case 0: break;
    case 1: goto PODSTJM;
    case 2: goto PRECHODNIK;
    case 3: case 30:
            goto PRIDAV_DELAJICI;
    case 4: goto PRIDAV_DELANY;
    case 5: goto NEDOKONAVY;
    case 6: goto PREDMINULY;
    default: NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
   }

  if (cas == 1) {                                       //minul˝ Ëas
    strcpy(g_slovo,g_slovodocasne);
    PRIDEJ_NA_KONEC("al");
    PRIDEJ_SE_SPRAVNOU_KONCOVKOU_SLOVESA(rod,cislo,zivotnost);

    DOPLN_POMOCNE_SLOVESO(osoba,cislo,cas,vid,0);
    if (zapor == 1) PRIDEJ_PRED_KAZDE_SLOVO("ne");
   }
  else if (cas == 2) {                                  //p¯Ìtomn˝ Ëas
    if (vid == 1 || vid == 2) return(0);                   //neexistuje p¯Ìsluön˝ tvar
    CAS2:
    strcpy(g_slovo,g_slovodocasne);
    switch(osoba) {
      case 1: if (cislo == 1) { PRIDEJ_NA_KONEC("·m");
                PRIDEJ_DO_FRONTY(); strcpy(g_slovo,g_slovodocasne);
                PRIDEJ_NA_KONEC("am");                 //dÏlam - nespisovnÈ
               }
              else PRIDEJ_NA_KONEC("·me");
              break;
      case 2: if (cislo == 1) PRIDEJ_NA_KONEC("·ö");
              else PRIDEJ_NA_KONEC("·te"); break;
      case 3: if (cislo == 1) PRIDEJ_NA_KONEC("·");
              else { PRIDEJ_NA_KONEC("ajÌ");
                PRIDEJ_DO_FRONTY(); strcpy(g_slovo,g_slovodocasne);
                PRIDEJ_NA_KONEC("aj");                   //dÏlaj - nespisovnÈ
               }
              break;
     }
    PRIDEJ_DO_FRONTY();
    if (zapor == 1) PRIDEJ_PRED_KAZDE_SLOVO("ne");
   }
  else if (cas == 3) {                                   //budoucÌ Ëas
    if (vid == 1 || vid == 2) goto CAS2;  //skloÚov·nÌ p¯Ìtomn˝ Ëas (bere - sebere) nebo (za)pomene

    CASUJ_VZOR_DELA(1,1,5,1,1,0,0,0);      //rekurze - infinitiv

    DOPLN_POMOCNE_SLOVESO(osoba,cislo,cas,vid,zapor);
   }
  else if (cas == 4) {                                   //rozkazovacÌ zp˘sob
    strcpy(g_slovo,g_slovodocasne);

    PRIDEJ_NA_KONEC("ej");

    PRIDEJ_S_KONCOVKOU_ROZKAZOVACIHO_SLOVESA(osoba,cislo,zapor);
   }
  else if (cas == 5) {                                   //infinitiv
    strcpy(g_slovo,g_slovodocasne);
    PRIDEJ_NA_KONEC("a");         //pomocn· konstrukce ke zjiötÏnÌ poËtu slabik
    if (POCET_SLABIK(g_slovo) >= 2 || zapor == 1) PRIDEJ_NA_KONEC("t");   //dÏlat, dotkat
    else { OREZ_POSLEDNI_ZNAKY(g_slovo,1); PRIDEJ_NA_KONEC("·t"); }  //tk·t
    PRIDEJ_DO_FRONTY();
    ZJEMNI_KONCOVKU_SLOVESA_1(); PRIDEJ_NA_KONEC("i");      //kniûnÌ tvar
    PRIDEJ_DO_FRONTY();
    if (zapor == 1) PRIDEJ_PRED_KAZDE_SLOVO("ne");
   }
  return(1);


  PODSTJM:                                      //slovesnÈ podstatnÈ jmÈno

  CASUJ_VZOR_DELA(3,1,2,1,0,0,zapor,0);     //rekurze - 3.osoba j.Ë. p¯Ìt.Ëasu
  OREZ_FRONTU_NA_1_SLOVO(1); strcpy(g_slovo,g_slovavefronte);
  VYMAZ_FRONTU();
  PRIDEJ_NA_KONEC("ÚÌ");
  PRIDEJ_DO_FRONTY();
  return(_staveni_);


  PRECHODNIK:                      //p¯echodnÌk (minul˝ nebo p¯Ìtomn˝)
  return(0);

  PRIDAV_DELAJICI:                 //slovesnÈ p¯ÌdavnÈ jmÈno (dÏlajÌcÌ)
  strcpy(g_slovo,g_slovodocasne);
  PRIDEJ_NA_KONEC("ajÌcÌ");
  PRIDEJ_DO_FRONTY();
  return(1);

  PRIDAV_DELANY:                   //slovesnÈ p¯ÌdavnÈ jmÈno (dÏlan˝)
  CASUJ_VZOR_DELA(1,1,1,1,0,0,zapor,1);     //rekurze - podst. jm. (dÏl·nÌ)
  VYGENERUJ_TVAR_DELANY(g_slovavefronte);
  return(1);

  NEDOKONAVY:                      //konverze dokonavÈho vidu na nedokonav˝
  strcpy(g_slovo,g_slovodocasne);
  PRIDEJ_NA_KONEC("·v·");
  PRIDEJ_DO_FRONTY(); return(_dela_);

  PREDMINULY:                   //"p¯edminul˝" tvar slovesa (dÏl·v·)
  strcpy(g_slovo,g_slovodocasne);
  PRIDEJ_NA_KONEC("·v·");
  PRIDEJ_DO_FRONTY(); return(_dela_);
 }

BYTE CASUJ_SLOVESO_JE(BYTE osoba,BYTE cislo,BYTE cas,BYTE rod,BYTE zivotnost,BYTE zapor,BYTE tvar) {

  switch(tvar) {
    case 0: break;
    case 1: goto PODSTJM;
    case 2: goto PRECHODNIK;
    case 6: goto PREDMINULY;
    default: NAHLAS_CHYBU(__FILE__,__LINE__,_NESPECIFIKOVANO_,_UKONCIT_);
   }

  if (cas == 1) {                                       //minul˝ Ëas
    strcpy(g_slovo,"byl");
    PRIDEJ_SE_SPRAVNOU_KONCOVKOU_SLOVESA(rod,cislo,zivotnost);

    DOPLN_POMOCNE_SLOVESO(osoba,cislo,cas,0,0);
    if (zapor == 1) PRIDEJ_PRED_KAZDE_SLOVO("ne");
   }
  else if (cas == 2) {                                  //p¯Ìtomn˝ Ëas
    switch(osoba) {
      case 1: if (cislo == 1) strcpy(g_slovo,"jsem,sem");  //sem - nespisovnÈ
              else strcpy(g_slovo,"jsme,sme"); break;      //sme - nespisovnÈ
      case 2: if (cislo == 1) strcpy(g_slovo,"jsi,jseö,seö,si");//jseö,seö,si - nespisovnÈ
              else strcpy(g_slovo,"jste,ste"); break;      //ste - nespisovnÈ
      case 3: if (cislo == 1) strcpy(g_slovo,"je");
              else strcpy(g_slovo,"jsou,sou"); break;      //sou - nespisovnÈ
     }
    PRIDEJ_DO_FRONTY();
    if (zapor == 1) {
	  if (osoba == 3 && cislo == 1) strcpy(g_slovavefronte,"nenÌ");
	  else PRIDEJ_PRED_KAZDE_SLOVO("ne");
	 }
   }
  else if (cas == 3) {                                   //budoucÌ Ëas
    switch(osoba) {
      case 1: if (cislo == 1) strcpy(g_slovo,"budu");
              else strcpy(g_slovo,"budeme,budem"); break;  //budem - nespisovnÈ
      case 2: if (cislo == 1) strcpy(g_slovo,"budeö");
              else strcpy(g_slovo,"budete"); break;
      case 3: if (cislo == 1) strcpy(g_slovo,"bude");
              else strcpy(g_slovo,"budou"); break;
     }
    PRIDEJ_DO_FRONTY();
    if (zapor == 1) PRIDEJ_PRED_KAZDE_SLOVO("ne");
   }
  else if (cas == 4) {                                   //rozkazovacÌ zp˘sob
    strcpy(g_slovo,"buÔ");

    PRIDEJ_S_KONCOVKOU_ROZKAZOVACIHO_SLOVESA(osoba,cislo,zapor);
   }
  else if (cas == 5) {                                   //infinitiv
    strcpy(g_slovo,"b˝t,b˝ùi");             //b˝ti - kniûnÌ tvar
    PRIDEJ_DO_FRONTY();
    if (zapor == 1) PRIDEJ_PRED_KAZDE_SLOVO("ne");
   }
  return(1);


  PODSTJM:                                      //slovesnÈ podstatnÈ jmÈno

  strcpy(g_slovo,"byùÌ");
