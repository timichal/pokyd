    PRIDEJ_NA_KONEC("el");
    PRIDEJ_SE_SPRAVNOU_KONCOVKOU_SLOVESA(rod,cislo,zivotnost);

    DOPLN_POMOCNE_SLOVESO(osoba,cislo,cas,vid,0);
    if (zapor == 1) PRIDEJ_PRED_KAZDE_SLOVO("ne");
   }
  else if (cas == 2) {                                  //p¯Ìtomn˝ Ëas
    if (vid == 1 || vid == 2) return(0);                   //neexistuje p¯Ìsluön˝ tvar
    CAS2:
    strcpy(g_slovo,g_slovodocasne);
    switch(osoba) {
      case 1: if (cislo == 1) { PRIDEJ_NA_KONEC("Ìm");
                PRIDEJ_DO_FRONTY(); strcpy(g_slovo,g_slovodocasne);
                PRIDEJ_NA_KONEC("im");                 //sazim - nespisovnÈ
               }
              else PRIDEJ_NA_KONEC("Ìme");
              break;
      case 2: if (cislo == 1) PRIDEJ_NA_KONEC("Ìö");
              else PRIDEJ_NA_KONEC("Ìte"); break;
      case 3: if (cislo == 1) PRIDEJ_NA_KONEC("Ì");
              else { PRIDEJ_NA_KONEC("Ì");
                PRIDEJ_DO_FRONTY(); strcpy(g_slovo,g_slovodocasne);
                ZJEMNI_KONCOVKU_SLOVESA_1(); PRIDEJ_NA_KONEC("ejÌ");
                PRIDEJ_DO_FRONTY(); OREZ_POSLEDNI_ZNAKY(g_slovo,1);
                                                //(oni) s·zej - nespisovnÈ
               }
              break;
     }
    PRIDEJ_DO_FRONTY();
    if (zapor == 1) PRIDEJ_PRED_KAZDE_SLOVO("ne");
   }
  else if (cas == 3) {                                   //budoucÌ Ëas
    if (vid == 1 || vid == 2) goto CAS2;  //skloÚov·nÌ p¯Ìtomn˝ Ëas (bere - sebere) nebo (za)pomene

    CASUJ_VZOR_SAZI(1,1,5,1,1,0,0,0);      //rekurze - infinitiv

    DOPLN_POMOCNE_SLOVESO(osoba,cislo,cas,vid,zapor);
   }
  else if (cas == 4) {                                   //rozkazovacÌ zp˘sob
    strcpy(g_slovo,g_slovodocasne);

    ZJEMNI_KONCOVKU_SLOVESA_1(); PRIDEJ_NA_KONEC("ej");

    PRIDEJ_S_KONCOVKOU_ROZKAZOVACIHO_SLOVESA(osoba,cislo,zapor);
   }
  else if (cas == 5) {                                   //infinitiv
    strcpy(g_slovo,g_slovodocasne);
