IDR_MENU MENU DISCARDABLE 
BEGIN
    POPUP "&IQ Pokyd"
    BEGIN
        MENUITEM SEPARATOR
        MENUITEM "&Nastavení...\tF4",           ID_NASTAVENI
        MENUITEM "&Konec\tAlt+F4",              ID_KONEC
        MENUITEM SEPARATOR
    END
    POPUP "&Nápovìda"
    BEGIN
        MENUITEM SEPARATOR
        MENUITEM "&Malá nápovìda\tF1",          ID_MALANAPOVEDA
        MENUITEM "&Velká nápovìda...\tAlt+F1",  ID_VELKANAPOVEDA
        MENUITEM SEPARATOR
        MENUITEM "&IQ Pokyd na internetu...\tAlt+F12", ID_NAPOVEDA_INTERNET
        MENUITEM "I&nformace o verzi\tAlt+V",   ID_OVERZI
        MENUITEM "&O programu\tShift+F1",       ID_OPROGRAMU
        MENUITEM SEPARATOR
    END
    MENUITEM "Nálada",                      ID_NASTAVENI, HELP
END


